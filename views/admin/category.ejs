<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>iZen | Category Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        :root { --izen-orange: #EF6627; }
        .add-btn { background-color: var(--izen-orange); color: white; border: none; }
        .add-btn:hover { background-color: #d4561f; color: white; }
        .actions i { cursor: pointer; font-size: 1.1rem; transition: transform 0.2s; }
        .actions i:hover { transform: scale(1.2); }
        .sidebar { transition: transform 0.3s ease; }
        .table thead { background-color: #f8f9fa; }
        
        @media (max-width: 767.98px) {
            .sidebar {
                position: fixed; top: 56px; left: 0; width: 200px; height: 100vh;
                background-color: #000; color: white; z-index: 1050; transform: translateX(-100%);
            }
            .sidebar.show { transform: translateX(0); }
        }
    </style>
</head>

<body class="bg-light">

    <%- include("../partials/admin/navbar.ejs") %>

    <div class="container-fluid px-4 mt-5">
        <div class="row justify-content-center">
            <div class="col-lg-2 d-none d-lg-block">
                <%- include("../partials/admin/sidebarLinks.ejs") %>
            </div>

            <div class="col-12 col-md-11 col-lg-9">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-header bg-white py-4 border-0">
                        <div class="d-flex justify-content-between align-items-center">
                            <h3 class="fw-bold mb-0">Product Categories</h3>
                            <a href="/admin/addCategory" class="btn add-btn px-4 py-2 rounded-pill">
                                <i class="bi bi-plus-lg me-2"></i>Add Category
                            </a>
                        </div>
                        
                        <div class="mt-4 col-md-8">
                            <form action="/admin/category" method="GET" class="d-flex gap-2">
                                <div class="input-group">
                                    <input type="text" name="search" class="form-control border-end-0" placeholder="Search Apple categories..." value="<%= search %>">
                                    <button class="btn btn-outline-secondary border-start-0" type="submit">
                                        <i class="bi bi-search"></i>
                                    </button>
                                </div>
                                <% if (search && search.trim() !== "") { %>
                                    <a href="/admin/category" class="btn btn-secondary rounded-pill px-4 d-flex align-items-center">Clear</a>
                                <% } %>
                            </form>
                        </div>
                    </div>

                    <div class="card-body px-4">
                        <div class="table-responsive">
                            <% if (cat && cat.length > 0) { %>
                                <table class="table align-middle">
                                    <thead>
                                        <tr>
                                            <th class="text-muted fw-semibold">SL No.</th>
                                            <th class="text-muted fw-semibold">Category Name</th>
                                            <th class="text-muted fw-semibold">Description</th>
                                            <th class="text-muted fw-semibold">Listed Status</th>
                                            <th class="text-muted fw-semibold text-center">Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% cat.forEach((category, index) => { %>
                                            <tr>
                                                <td><%= (currentPage - 1) * 5 + (index + 1) %></td>
                                                <td><span class="fw-bold text-dark"><%= category.name %></span></td>
                                                <td class="text-muted small w-25"><%= category.description %></td>
                                                <td>
                                                    <% if(category.isListed) { %>
                                                        <span class="badge bg-success-subtle text-success px-3 py-2 rounded-pill">Listed</span>
                                                    <% } else { %>
                                                        <span class="badge bg-danger-subtle text-danger px-3 py-2 rounded-pill">Unlisted</span>
                                                    <% } %>
                                                </td>
                                                <td>
                                                    <div class="d-flex justify-content-center gap-3 actions">
                                                        <a href="/admin/editCategory/<%= category._id %>" title="Edit">
                                                            <i class="bi bi-pencil-square text-primary"></i>
                                                        </a>
                                                        
                                                        <% if(category.isListed) { %>
                                                            <i class="bi bi-eye-slash text-warning" onclick='confirmListAction("<%= category._id %>", "/admin/blockCategory", "PATCH", "Unlist")' title="Unlist"></i>
                                                        <% } else { %>
                                                            <i class="bi bi-eye text-success" onclick='confirmListAction("<%= category._id %>", "/admin/unBlockCategory", "PATCH", "List")' title="List"></i>
                                                        <% } %>
                                                        
                                                        <i class="bi bi-trash text-danger" onclick='setActionId("<%= category._id %>")' data-bs-toggle="modal" data-bs-target="#deleteModal" title="Delete"></i>
                                                    </div>
                                                </td>
                                            </tr>
                                        <% }) %>
                                    </tbody>
                                </table>
                            <% } else { %>
                                <div class="text-center py-5">
                                    <h5 class="text-muted">No categories found for iZen.</h5>
                                </div>
                            <% } %>
                        </div>
                    </div>

                    <div class="card-footer bg-white border-0 py-4">
                        <nav aria-label="Page navigation">
                            <ul class="pagination justify-content-center mb-0">
                                <li class="page-item <%= currentPage <= 1 ? 'disabled' : '' %>">
                                    <a class="page-link" href="/admin/category?page=<%= currentPage - 1 %>&search=<%= encodeURIComponent(search) %>">Previous</a>
                                </li>
                                <% for(let i = 1; i <= totalPages; i++) { %>
                                    <li class="page-item <%= currentPage === i ? 'active' : '' %>">
                                        <a class="page-link" 
                                           style="<%= currentPage === i ? 'background-color: var(--izen-orange); border-color: var(--izen-orange);' : '' %>"
                                           href="/admin/category?page=<%= i %>&search=<%= encodeURIComponent(search) %>">
                                             <%= i %>
                                        </a>
                                    </li>
                                <% } %>
                                <li class="page-item <%= currentPage >= totalPages ? 'disabled' : '' %>">
                                    <a class="page-link" href="/admin/category?page=<%= currentPage + 1 %>&search=<%= encodeURIComponent(search) %>">Next</a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="modal fade" id="deleteModal" tabindex="-1">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-body text-center p-5">
                    <i class="bi bi-exclamation-triangle text-danger display-1"></i>
                    <h3 class="mt-3">Delete Category?</h3>
                    <p class="text-muted">This will remove the category from your active listings.</p>
                    <div class="d-flex justify-content-center gap-2 mt-4">
                        <button class="btn btn-light px-4" data-bs-dismiss="modal">Cancel</button>
                        <button class="btn btn-danger px-4" onclick="executeAction('/admin/deleteCategory', 'DELETE')">Confirm Delete</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        let currentId = null;
        function setActionId(id) { currentId = id; }

        // Handles triggering List and Unlist confirmations instantly
        function confirmListAction(id, url, method, actionName) {
            Swal.fire({
                title: `${actionName} Category?`,
                text: `Are you sure you want to ${actionName.toLowerCase()} this category?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: '#EF6627',
                cancelButtonColor: '#6c757d',
                confirmButtonText: `Yes, ${actionName} it!`
            }).then((result) => {
                if (result.isConfirmed) {
                    setActionId(id);
                    executeAction(url, method);
                }
            });
        }

        // Base Unified Fetch Submitter Engine
        async function executeAction(url, method) {
            try {
                const response = await fetch(url, {
                    method: method,
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ id: currentId })
                });

                if (response.ok) {
                    const activeModalElement = document.querySelector('.modal.show');
                    if (activeModalElement) {
                        const modalInstance = bootstrap.Modal.getInstance(activeModalElement);
                        if (modalInstance) modalInstance.hide();
                    }

                    Swal.fire({ icon: 'success', title: 'Action Successful', timer: 1000, showConfirmButton: false })
                    .then(() => window.location.reload());
                } else {
                    Swal.fire({ icon: 'error', title: 'Action Failed', text: 'Please try again.' });
                }
            } catch (error) {
                console.error("Action Error:", error);
                Swal.fire({ icon: 'error', title: 'Network Error', text: 'Something went wrong.' });
            }
        }
    </script>
</body>
</html>