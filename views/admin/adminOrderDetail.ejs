<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= typeof title !== 'undefined' ? title : 'iZen | Inspect Transaction Context' %></title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    
    <style>
        :root { 
            --apple-black: #1d1d1f; 
            --apple-dark-gray: #424245;
            --apple-border: #e5e5ea; 
            --apple-bg: #fbfbfd;
            --apple-blue: #0071e3;
            --apple-gray: #f5f5f7;
        }
        body { 
            background-color: var(--apple-bg); 
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; 
            color: var(--apple-black);
            -webkit-font-smoothing: antialiased;
        }
        .sidebar { transition: transform 0.3s ease; }
        
        .glass-panel {
            background: #ffffff;
            border: 1px solid var(--apple-border);
            border-radius: 18px;
            padding: 2.5rem;
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
        }
        .back-nav {
            text-decoration: none;
            color: #86868b;
            font-size: 0.9rem;
            font-weight: 500;
            transition: color 0.2s;
        }
        .back-nav:hover { color: var(--apple-blue); }
        
        .order-title { font-size: 2.2rem; font-weight: 700; letter-spacing: -0.03em; color: var(--apple-black); }
        .meta-timestamp { color: #86868b; font-size: 0.95rem; font-weight: 400; }
        
        .premium-dropdown {
            background-color: var(--apple-bg);
            border: 1px solid var(--apple-border);
            border-radius: 8px;
            padding: 0.4rem 2rem 0.4rem 0.75rem;
            font-size: 0.85rem;
            font-weight: 600;
            color: var(--apple-black);
            background-image: url("data:image/svg+xml,%3csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 16 16'%3e%3cpath fill='none' stroke='%231d1d1f' stroke-linecap='round' stroke-linejoin='round' stroke-width='2' d='m2 5 6 6 6-6'/%3e%3c/svg%3e");
            background-repeat: no-repeat;
            background-position: right 0.75rem center;
            background-size: 8px;
            appearance: none;
            transition: all 0.25s ease;
            cursor: pointer;
            width: 170px;
        }
        .premium-dropdown:focus {
            border-color: var(--apple-blue);
            box-shadow: 0 0 0 4px rgba(0, 113, 227, 0.15);
            outline: none;
        }

        .section-label {
            font-size: 0.8rem;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #86868b;
            margin-bottom: 0.75rem;
        }
        .data-string { font-size: 1.05rem; font-weight: 500; color: var(--apple-black); }
        .data-sub { font-size: 0.9rem; color: #6e6e73; }

        .product-img-box {
            width: 50px;
            height: 50px;
            background-color: var(--apple-gray);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            border: 1px solid var(--apple-border);
            flex-shrink: 0;
        }

        .product-img-box img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            padding: 4px;
        }

        .premium-table { width: 100%; border-collapse: collapse; margin-top: 1rem; }
        .premium-table th {
            padding: 12px 10px;
            font-size: 0.8rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #86868b;
            border-bottom: 1px solid var(--apple-border);
        }
        .premium-table td {
            padding: 20px 10px;
            border-bottom: 1px solid #f5f5f7;
            font-size: 0.95rem;
            vertical-align: middle;
        }
        
        .summary-box {
            max-width: 360px;
            margin-left: auto;
            padding-top: 1.5rem;
        }

        .summary-line {
            display: flex;
            justify-content: space-between;
            font-size: 0.95rem;
            margin-bottom: 0.6rem;
            color: var(--apple-black);
        }

        .total-display { font-size: 1.4rem; font-weight: 700; letter-spacing: -0.02em; color: var(--apple-black); }

        @media (max-width: 767.98px) {
            .sidebar {
                position: fixed; top: 56px; left: 0; width: 200px; height: 100vh;
                background-color: #000; color: white; z-index: 1050; transform: translateX(-100%);
            }
            .sidebar.show { transform: translateX(0); }
        }
    </style>
</head>
<body class="bg-light">

    <%- include("../partials/admin/navbar.ejs") %>

    <div class="container-fluid">
        <div class="row">
            <div class="col-md-2 sidebar p-0">
                <%- include("../partials/admin/sidebarLinks.ejs") %>
            </div>

            <div class="col-12 col-md-10 col-lg-9 my-4 mb-5">
                
                <div class="mb-4">
                    <a href="/admin/orders" class="back-nav"><i class="bi bi-arrow-left-short fs-5 align-middle"></i> Return to Order Registry</a>
                </div>

                <div class="glass-panel">
                    <!-- Order Header -->
                    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center border-bottom pb-4 mb-4">
                        <div>
                            <h1 class="order-title">Order #<%= order.orderId %></h1>
                            <div class="meta-timestamp mt-1">Transaction Logged: <%= new Date(order.createdAt || order.date).toLocaleString('en-IN') %></div>
                        </div>
                        <div class="mt-3 mt-md-0 text-md-end">
                            <span class="badge bg-dark px-3 py-2 text-capitalize"><%= order.status || 'Processing' %></span>
                        </div>
                    </div>

                    <!-- Customer, Address & Payment Info Grid -->
                    <div class="row mb-4 pb-4 border-bottom">
                        <div class="col-md-4 mb-3 mb-md-0">
                            <div class="section-label">Customer Profile</div>
                            <div class="data-string"><%= order.user?.username || order.user?.name || 'Guest User' %></div>
                            <div class="data-sub mt-1"><%= order.user?.email || 'No email registered' %></div>
                        </div>

                        <div class="col-md-4 mb-3 mb-md-0">
                            <div class="section-label">Shipping Address</div>
                            <% if (order.shippingAddress) { %>
                                <div class="data-string"><%= order.shippingAddress.fullname || order.shippingAddress.name || 'N/A' %></div>
                                <div class="data-sub mt-1" style="line-height: 1.4;">
                                    <%= order.shippingAddress.address || order.shippingAddress.street || '' %><br>
                                    <% if (order.shippingAddress.city) { %><%= order.shippingAddress.city %>, <% } %>
                                    <%= order.shippingAddress.state || '' %> <%= order.shippingAddress.pincode || order.shippingAddress.zip || '' %><br>
                                    Phone: <%= order.shippingAddress.phone || 'N/A' %>
                                </div>
                            <% } else { %>
                                <div class="data-sub">No address data available</div>
                            <% } %>
                        </div>

                        <div class="col-md-4 text-md-end">
                            <div class="section-label">Settlement Logistics</div>
                            <div class="data-string"><%= order.paymentMethod || 'Cash On Delivery' %></div>
                            <div class="data-sub mt-1">Payment Status: <span class="fw-bold text-success"><%= order.paymentStatus || 'Verified' %></span></div>
                        </div>
                    </div>

                    <!-- Product Manifest Table -->
                    <div class="mt-2">
                        <div class="section-label">Manifest Allocation</div>
                        <table class="premium-table">
                            <thead>
                                <tr>
                                    <th style="width: 45%">Product Allocation</th>
                                    <th style="width: 15%" class="text-center">Quantity</th>
                                    <th style="width: 20%" class="text-end">Unit Price</th>
                                    <th style="width: 20%" class="text-end">Item Status</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% order.items.forEach(item => { %>
                                    <tr>
                                        <td>
                                            <div class="d-flex align-items-center gap-3">
                                                <% if (item.image) { %>
                                                    <div class="product-img-box">
                                                        <img src="<%= item.image.startsWith('/') ? item.image : '/' + item.image %>" alt="<%= item.name %>" onerror="this.onerror=null; this.src='/images/login.png';">
                                                    </div>
                                                <% } %>
                                                <div>
                                                    <div class="fw-semibold text-dark"><%= item.name %></div>
                                                    <% 
                                                        let displayColor = item.variantColor || item.variant;
                                                        let isGenericConfig = !displayColor || 
                                                                             displayColor === 'Standard Config' || 
                                                                             displayColor === 'Default Config' || 
                                                                             displayColor === 'Base Specification' || 
                                                                             displayColor === 'Standard Edition' ||
                                                                             displayColor.trim() === '';
                                                    %>
                                                    <% if (!isGenericConfig) { %>
                                                        <div class="data-sub text-muted mt-1" style="font-size: 0.8rem;">
                                                            <span class="text-muted text-capitalize"><%= displayColor %></span>
                                                        </div>
                                                    <% } %>
                                                </div>
                                            </div>
                                        </td>
                                        <td class="text-center text-secondary fw-medium"><%= item.quantity %></td>
                                        <td class="text-end fw-semibold text-dark">Rs. <%= item.price.toLocaleString('en-IN') %></td>
                                        <td class="text-end">
                                            <% 
                                                let itemStatusNormalized = (item.status || '').trim().toLowerCase(); 
                                            %>
                                            
                                            <% if (itemStatusNormalized === 'cancelled') { %>
                                                <span class="badge bg-danger-subtle text-danger px-3 py-2 small rounded-pill fw-bold">Cancelled</span>
                                            <% } else if (itemStatusNormalized === 'returned') { %>
                                                <span class="badge bg-secondary-subtle text-secondary px-3 py-2 small rounded-pill fw-bold">Returned</span>
                                            <% } else if (itemStatusNormalized === 'return rejected') { %>
                                                <span class="badge bg-danger-subtle text-danger px-3 py-2 small rounded-pill fw-bold">Return Rejected</span>
                                            <% } else if (itemStatusNormalized === 'return request pending' || itemStatusNormalized === 'return review') { %>
                                                <!-- Action Buttons replacing dropdown when return is requested -->
                                                <div class="d-flex gap-2 justify-content-end align-items-center">
                                                    <button type="button" 
                                                            class="btn btn-sm btn-outline-success fw-semibold px-2 py-1" 
                                                            onclick="triggerStatusUpdate('<%= order._id %>', '<%= item.variantId %>', 'Returned')">
                                                        Approve
                                                    </button>
                                                    <button type="button" 
                                                            class="btn btn-sm btn-outline-danger fw-semibold px-2 py-1" 
                                                            onclick="triggerStatusUpdate('<%= order._id %>', '<%= item.variantId %>', 'Return Rejected')">
                                                        Decline
                                                    </button>
                                                </div>
                                            <% } else { %>
                                                <select class="premium-dropdown" 
                                                        data-current-status="<%= item.status %>"
                                                        onchange="triggerStatusUpdate('<%= order._id %>', '<%= item.variantId %>', this.value, this)">
                                                    
                                                    <!-- Delivery Options -->
                                                    <option value="Pending" <%= item.status === 'Pending' ? 'selected' : '' %>>Pending</option>
                                                    <option value="Processing" <%= item.status === 'Processing' ? 'selected' : '' %>>Processing</option>
                                                    <option value="Shipped" <%= item.status === 'Shipped' ? 'selected' : '' %>>Shipped</option>
                                                    <option value="Out for Delivery" <%= item.status === 'Out for Delivery' ? 'selected' : '' %>>Out for Delivery</option>
                                                    <option value="Delivered" <%= item.status === 'Delivered' ? 'selected' : '' %>>Delivered</option>
                                                    
                                                    <!-- Admin Direct Cancel Allowed Only if in Warehouse Start Stages -->
                                                    <% if (itemStatusNormalized === 'pending' || itemStatusNormalized === 'processing') { %>
                                                        <option value="Cancelled">Cancelled</option>
                                                    <% } %>
                                                </select>
                                            <% } %>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    </div>

                    <!-- Comprehensive Financial Summary Breakdown -->
                    <div class="summary-box">
            <div class="summary-line">
    <span class="text-muted">Subtotal</span>
    <span>₹<%= ((order.subtotal || order.totalAmount || 0)).toLocaleString('en-IN') %></span>
</div>
<div class="summary-line">
    <span class="text-muted">Shipping Charges</span>
    <span>₹<%= 50 %></span>
</div>
<div class="summary-line">
    <span class="text-muted">Discount Applied</span>
    <span class="text-success">-₹<%= ((order.discountAmount || 0)).toLocaleString('en-IN') %></span>
</div>
<hr style="border-top: 1px dashed var(--apple-border); margin: 1rem 0;">
<div class="summary-line fw-bold" style="font-size: 1.2rem;">
    <span>Total Amount</span>
    <span style="color: var(--apple-black);">₹<%= ((order.totalAmount || 0)).toLocaleString('en-IN') %></span>
</div>
        </div>

                </div>
            </div>

        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
    async function triggerStatusUpdate(orderId, variantId, newStatus, selectorElement = null) {
        const initialStatus = selectorElement ? selectorElement.getAttribute('data-current-status') : null;

        if (selectorElement && newStatus === initialStatus) return;
        
        try {
            const response = await fetch('/admin/orders/update-item-status', {
                method: 'PATCH',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ orderId, variantId, status: newStatus })
            });

            const data = await response.json();

            if (response.ok && data.success) {
                if (selectorElement) {
                    selectorElement.setAttribute('data-current-status', newStatus);
                }
                
                Swal.fire({ 
                    icon: 'success', 
                    title: 'Status Synchronized', 
                    text: `This item is now marked as ${newStatus}.`, 
                    timer: 1500, 
                    showConfirmButton: false 
                }).then(() => {
                    location.reload();
                });
            } else {
                if (selectorElement) selectorElement.value = initialStatus;
                Swal.fire({ 
                    icon: 'warning', 
                    title: 'Action Restrained', 
                    text: data.message || 'Illegal step update configuration sequence.' 
                });
            }
        } catch (err) {
            console.error("Transmission Failure:", err);
            if (selectorElement) selectorElement.value = initialStatus;
            Swal.fire({ 
                icon: 'error', 
                title: 'Ecosystem Sync Error', 
                text: 'Network request rejected.' 
            });
        }
    }
    </script>
</body>
</html>