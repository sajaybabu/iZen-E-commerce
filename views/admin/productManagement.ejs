<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>iZen Admin - Product Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <style>
        .test:hover {
            background-color: rgb(238, 238, 238);
        }

        .add-user-btn {
            background-color: #000000;
            /* Sophisticated Apple black theme */
        }

        .active::after {
            content: '';
            display: block;
            position: absolute;
            width: 100%;
            height: 3px;
            background: black;
            bottom: -7px;
        }

        .actions {
            color: #151414;
        }

        .sidebar {
            transition: transform 0.3s ease;
        }

        @media (max-width: 767.98px) {
            .sidebar {
                position: fixed;
                top: 56px;
                left: 0;
                width: 200px;
                height: 100vh;
                background-color: #000;
                color: white;
                z-index: 1050;
                transform: translateX(-100%);
            }

            .sidebar.show {
                transform: translateX(0);
            }
        }
    </style>
</head>

<body>

    <%- include("../partials/admin/navbar.ejs") %>

        <div class="container px-0 mt-5">
            <div class="row row-cols-1 justify-content-between mx-0">
                <div
                    class="col col-md-3 col-lg-2 border border-secondary rounded text-secondary sidebar align-self-start p-0">
                    <%- include("../partials/admin/sidebarLinks.ejs") %>
                </div>

                <div class="card col col-md-8 col-lg-9 px-0 mx-md-3 mt-4 mt-md-0">
                    <div class="card-header">
                        <h1 class="text-center my-3">Product Management</h1>

                        <div class="container">
                            <div class="row justify-content-between my-4 align-items-center">
                                <form action="/admin/searchProduct" class="col-8 col-lg-7 d-flex gap-2" method="post">
                                    <input class="form-control me-2" name="name" type="search"
                                        placeholder="Search Apple Devices..." aria-label="Search"
                                        value="<%= typeof searchQuery !== 'undefined' ? searchQuery : '' %>" />

                                    <button class="btn btn-outline-dark" type="submit">Search</button>

                                    <% if (typeof isSearchPage !=='undefined' && isSearchPage) { %>
                                        <a href="/admin/products"
                                            class="btn btn-secondary d-flex align-items-center justify-content-center text-decoration-none">Clear</a>
                                        <% } %>
                                </form>

                                <div class="col-4 col-lg-3 d-flex justify-content-end">
                                    <a role="button" href="/admin/products/add"
                                        class="add-user-btn text-light border-0 rounded px-4 py-2 text-decoration-none">+
                                        Add new</a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="card-body">
                        <div class="table-responsive">
                            <% if (products && products.length> 0) { %>
                                <table class="table table-striped align-middle">
                                    <thead>
                                        <tr>
                                            <th>No.</th>
                                            <th>Device Name</th>
                                            <th>Category</th>
                                            <th>Price</th>
                                            <th>Stock</th>
                                            <th>Status</th>
                                            <th>Actions</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% products.forEach((product, index)=> {
                                            let currentStock = typeof product.stock !== 'undefined' ? product.stock :
                                            (product.variants ? product.variants.reduce((acc, curr) => acc +
                                            (curr.quantity || 0), 0) : 0);
                                            %>
                                            <tr style="cursor: pointer;" onclick='productInfo("<%= product._id%>")'
                                                class="test">
                                                <td>
                                                    <%= index + 1 %>
                                                </td>
                                                <td>
                                                    <div class="d-flex align-items-center gap-3">
                                                        <img src="<%= product.images && product.images.length > 0 ? product.images[0] : '/uploads/default-apple.png' %>"
                                                            alt="<%= product.name %>"
                                                            style="max-width: 50px; max-height: 50px; object-fit: contain;">
                                                        <span class="fw-semibold">
                                                            <%= product.name %>
                                                        </span>
                                                    </div>
                                                </td>
                                                <td><span class="badge bg-secondary">
                                                        <%= product.category %>
                                                    </span></td>
                                                <td>
                                                    ₹<%= product.price ? product.price.toLocaleString('en-IN') :
                                                        (product.variants && product.variants.length> 0 ?
                                                        product.variants[0].price.toLocaleString('en-IN') : '0') %>
                                                </td>
                                                <td>
                                                    <%= currentStock %> units
                                                </td>
                                                <td>
                                                    <% if (product.isBlocked) { %>
                                                        <span class="badge bg-danger">Blocked</span>
                                                        <% } else if (currentStock===0) { %>
                                                            <span class="badge bg-danger">Out of Stock</span>
                                                            <% } else if (currentStock < 10) { %>
                                                                <span class="badge bg-warning text-dark">Low
                                                                    Stock</span>
                                                                <% } else { %>
                                                                    <span class="badge bg-success">In Stock</span>
                                                                    <% } %>
                                                </td>

                                                <td>
                                                    <div class="d-flex gap-3">
                                                        <a class="actions" href="/admin/editProduct/<%= product._id %>"
                                                            onclick="event.stopPropagation();">
                                                            <i class="bi bi-pencil-square text-primary"></i>
                                                        </a>
                                                        <a class="actions"
                                                            onclick='deleteCategory(event, "<%= product._id%>")'
                                                            data-bs-toggle="modal" data-bs-target="#deleteModal">
                                                            <i class="bi bi-trash text-danger"></i>
                                                        </a>
                                                    </div>
                                                </td>
                                            </tr>
                                            <% }) %>
                                    </tbody>
                                </table>
                                <% } else { %>
                                    <h3 class="text-center text-muted my-5">No Apple products found. Let's seed your
                                        inventory!</h3>
                                    <% } %>
                        </div>
                    </div>

                    <% if (typeof prevPage !=='undefined' && typeof nextPage !=='undefined' ) { %>
                        <div class="mb-4 mx-auto">
                            <a href="/admin/products?page=<%= prevPage %>"
                                class="text-light btn bg-secondary rounded border-0 px-3 py-1 <%= typeof prevDisable !== 'undefined' ? prevDisable : '' %>">Prev</a>
                            <a href="/admin/products?page=<%= nextPage %>"
                                class="text-light btn rounded border-0 px-3 py-1 <%= typeof nextDisable !== 'undefined' ? nextDisable : '' %>"
                                style="background-color: #000000;">Next</a>
                        </div>
                        <% } %>
                </div>
            </div>
        </div>

        <div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content">
                    <div class="modal-body px-5">
                        <h1 class="fs-3 text-center mt-2 mb-4 fw-bold">Remove Product</h1>
                        <p class="fs-6 text-center text-muted mb-4">Are you sure you want to completely remove this
                            product from the store?</p>
                        <div class="d-flex justify-content-center gap-3 mb-3">
                            <button class="border-0 rounded px-4 py-2 bg-secondary text-light"
                                data-bs-dismiss="modal">Cancel</button>
                            <button class="border-0 rounded px-4 py-2 text-light" style="background-color: #dc3545;"
                                onclick="confirmDelete()">Delete</button>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <script>
            const sidebar = document.querySelector('.sidebar');
            const toggleBtn = document.getElementById('menuToggle');

            if (toggleBtn) {
                toggleBtn.addEventListener('click', () => {
                    sidebar.classList.toggle('show');
                });
            }

            let deleteId;

            function deleteCategory(e, id) {
                e.stopPropagation();
                deleteId = id;
            }

            async function confirmDelete() {
                if (!deleteId) return;

                const res = await fetch(`/admin/deleteProduct/${deleteId}`, {
                    method: "DELETE"
                });

                if (res.ok) {
                    window.location.reload();
                } else {
                    alert("Failed to delete product. Please check console logs.");
                }
            }

            async function productInfo(id) {
                window.location.href = `/admin/products/view/${id}`;
            }
        </script>
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>