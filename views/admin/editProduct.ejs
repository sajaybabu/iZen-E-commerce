<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>iZen Admin - Edit Product</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">    
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/sweetalert2@11/dist/sweetalert2.min.css">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>    
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>

    <style>
        body {
            background-color: #f5f5f7;
            color: #1d1d1f;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }
        .form-control, .form-select {
            border-color: #d2d2d7;
            border-radius: 8px !important;
            padding: 0.6rem 0.9rem;
            font-size: 0.95rem;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }
        .form-control:focus, .form-select:focus {
            border-color: #0071e3;
            box-shadow: 0 0 0 4px rgba(0, 113, 227, 0.15);
        }
        .variant-card { 
            border: 1px solid #e5e5ea !important; 
            background-color: #ffffff; 
            border-radius: 12px; 
            padding: 24px;
            margin-bottom: 24px;
            transition: box-shadow 0.2s ease;
        }
        .variant-card:hover {
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
        }
        .no-spinners::-webkit-outer-spin-button, 
        .no-spinners::-webkit-inner-spin-button { 
            -webkit-appearance: none; 
            margin: 0; 
        }
        .no-spinners { 
            -moz-appearance: textfield; 
        }
        .img-wrapper-node {
            position: relative;
            width: 90px;
            height: 90px;
        }
        .image-preview { 
            width: 100%; 
            height: 100%; 
            object-fit: cover; 
            border: 1px solid #e5e5ea; 
            padding: 2px; 
            background: #fff;
            border-radius: 8px !important;
        }
        .delete-overlay-btn {
            position: absolute;
            top: -6px;
            right: -6px;
            background-color: #ff3b30;
            color: #fff;
            border: none;
            border-radius: 50%;
            width: 22px;
            height: 22px;
            font-size: 11px;
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 2px 6px rgba(0,0,0,0.15);
            cursor: pointer;
            transition: transform 0.2s;
            z-index: 5;
        }
        .delete-overlay-btn:hover {
            transform: scale(1.15);
            background-color: #d70015;
        }
        .image-label {
            border: 2px dashed #0071e3;
            border-radius: 10px;
            cursor: pointer;
            background-color: rgba(0, 113, 227, 0.02);
            transition: background-color 0.2s ease, border-color 0.2s ease;
        }
        .image-label:hover {
            background-color: rgba(0, 113, 227, 0.06);
            border-color: #0077ed;
        }
        .cropper-container-modal {
            max-height: 400px;
            overflow: hidden;
            background-color: #f8f9fa;
            border-radius: 8px;
        }
        .cropper-container-modal img {
            max-width: 100%;
            display: block;
        }
        .add-attribute-link {
            color: #0071e3;
            font-size: 0.85rem;
            font-weight: 500;
            cursor: pointer;
            display: inline-block;
            text-decoration: none;
        }
        .add-attribute-link:hover {
            text-decoration: underline;
        }
        .btn-publish {
            background-color: #0071e3;
            color: #ffffff;
            border-radius: 10px;
            border: none;
            font-weight: 600;
            transition: background-color 0.2s ease, transform 0.1s ease;
        }
        .btn-publish:hover {
            background-color: #0077ed;
            color: #ffffff;
        }
        .btn-publish:active {
            transform: scale(0.98);
        }
    </style>
</head>
<body>
    <%- include("../partials/admin/navbar.ejs") %>
    <div class="container my-5" style="max-width: 960px;">
        <div class="d-flex align-items-center justify-content-between pb-3 mb-4 border-bottom">
            <div class="d-flex align-items-center gap-3">
                <a href="/admin/products" class="btn btn-outline-secondary btn-sm rounded-pill px-3"><i class="bi bi-arrow-left me-1"></i> Back</a>
                <h2 class="m-0 fs-4 fw-bold text-dark" style="letter-spacing: -0.5px;">Edit Apple Device</h2>
            </div>
            <span class="badge bg-light text-secondary border px-3 py-2 rounded-pill small">iZen Catalog</span>
        </div>

        <form id="editProductForm" action="/admin/updateProduct/<%= product._id %>" method="POST" enctype="multipart/form-data">            
            <div class="card border-0 shadow-sm p-4 p-md-5 rounded-4 mb-4" style="background-color: #ffffff;">
                <div class="mb-4">
                    <label class="d-block mb-2 fw-semibold small text-uppercase text-secondary" style="letter-spacing: 0.5px;">Device Name</label>
                    <input type="text" name="name" id="productNameInput" class="form-control" value="<%= product.name %>" placeholder="e.g. iPhone 15 Pro Max" required>
                </div>                
                <div class="mb-4">
                    <label class="d-block mb-2 fw-semibold small text-uppercase text-secondary" style="letter-spacing: 0.5px;">Description</label>
                    <textarea name="description" id="productDescInput" class="form-control" rows="4" placeholder="Provide product specifications and overview..." required><%= product.description %></textarea>
                </div>

                <div class="row row-cols-1 row-cols-md-2 g-3">
                    <div>
                        <label class="d-block mb-2 fw-semibold small text-uppercase text-secondary" style="letter-spacing: 0.5px;">Category</label>
                        <select name="category" class="form-select" required>
                            <option value="iPhone" <%= product.category === 'iPhone' ? 'selected' : '' %>>iPhone</option>
                            <option value="iPad" <%= product.category === 'iPad' ? 'selected' : '' %>>iPad</option>
                            <option value="MacBook" <%= product.category === 'MacBook' ? 'selected' : '' %>>MacBook</option>
                            <option value="AirPods" <%= product.category === 'AirPods' ? 'selected' : '' %>>AirPods</option>
                            <option value="Apple Watch" <%= product.category === 'Apple Watch' ? 'selected' : '' %>>Apple Watch</option>
                        </select>
                    </div>
                </div>
            </div>

            <div class="d-flex align-items-center justify-content-between mb-3">
                <h5 class="fw-bold m-0 text-dark fs-5">Product Variants</h5>
                <span class="text-muted small">Minimum 1 variant required</span>
            </div>

            <div id="variants-wrapper">
                <% product.variants.forEach((variant, index) => { %>
                    <div class="variant-card position-relative shadow-sm" id="variant-session-<%= index + 1 %>" data-variant-id="<%= variant._id %>">
                        <button type="button" class="btn-close position-absolute top-0 end-0 m-3 small" onclick="removeVariantCard(<%= index + 1 %>)"></button>
                        <div class="row g-3">
                            <div class="col-md-7">
                                <div class="row g-2 mb-2">
                                    <div class="col-5"><span class="small fw-semibold text-secondary text-uppercase" style="font-size: 0.75rem;">Attribute type</span></div>
                                    <div class="col-5"><span class="small fw-semibold text-secondary text-uppercase" style="font-size: 0.75rem;">Attribute value</span></div>
                                    <div class="col-2"></div>
                                </div>

                                <div id="attributes-container-<%= index + 1 %>">
                                    <% Object.entries(variant.attributes || {}).forEach(([key, val]) => { %>
                                        <div class="row g-2 my-1 attribute-row align-items-center">
                                            <div class="col-5">
                                                <input type="text" class="form-control attr-type" value="<%= key %>" placeholder="e.g. Storage" required>
                                            </div>
                                            <div class="col-5">
                                                <input type="text" class="form-control attr-val" value="<%= val %>" placeholder="e.g. 256GB" required>
                                            </div>
                                            <div class="col-2 text-center">
                                                <button type="button" class="btn btn-outline-danger btn-sm border-0 rounded-circle" onclick="removeAttributeRow(this, <%= index + 1 %>)">
                                                    <i class="bi bi-trash3"></i>
                                                </button>
                                            </div>
                                        </div>
                                    <% }) %>
                                </div>                                
                                <div class="mt-2">
                                    <span class="add-attribute-link mt-2" onclick="addAttributeRow(<%= index + 1 %>)">
                                        <i class="bi bi-plus-circle me-1"></i> Add Custom Attribute
                                    </span>
                                </div>
                            </div>
                            <div class="col-md-5 border-start border-light-subtle ps-md-4 mt-3 mt-md-0">
                                <div class="mb-3">
                                    <label class="small fw-semibold text-secondary text-uppercase d-block mb-1" style="font-size: 0.75rem;">Quantity</label>
                                    <div class="input-group" style="width: 150px;"> 
                                        <button class="btn btn-outline-secondary" type="button" onclick="stepQuantity(<%= index + 1 %>, -1)">-</button>
                                        <input type="number" id="quantity-<%= index + 1 %>" class="form-control text-center no-spinners target-qty-val" value="<%= variant.quantity %>" min="0" required>
                                        <button class="btn btn-outline-secondary" type="button" onclick="stepQuantity(<%= index + 1 %>, 1)">+</button>
                                    </div>
                                </div>

                                <div class="mb-3">
                                    <label class="small fw-semibold text-secondary text-uppercase d-block mb-1" style="font-size: 0.75rem;">Price (₹)</label>
                                    <input type="number" id="price-<%= index + 1 %>" class="form-control target-price-val" value="<%= variant.price %>" placeholder="0.00" min="1" step="any" required>
                                </div>
                            </div>
                        </div>

                        <div class="mt-4 pt-3 border-top">
                            <p class="fw-semibold small text-secondary text-uppercase mb-2" style="font-size: 0.75rem;">Display Images (Minimum 3 Required)</p>
                            <div class="d-flex flex-wrap gap-3 mb-3 image-row-container" id="imageRow-<%= index + 1 %>">
                                <% if(variant.images && variant.images.length > 0) { %>
                                    <% variant.images.forEach((imgUrl, imgIdx) => { %>
                                        <div class="img-wrapper-node existing-asset-instance" data-image-url="<%= imgUrl %>">
                                            <img src="<%= imgUrl %>" class="image-preview rounded shadow-sm" alt="preview">
                                            <button type="button" class="delete-overlay-btn" onclick="removeExistingSavedAsset(this)">
                                                <i class="bi bi-x"></i>
                                            </button>
                                        </div>
                                    <% }) %>
                                <% } else { %>
                                    <span class="text-muted small no-assets-flag"><i class="bi bi-exclamation-circle text-warning"></i> No files uploaded. At least 3 images required.</span>
                                <% } %>
                            </div>

                            <div class="d-flex justify-content-start">
                                <label for="image-<%= index + 1 %>" class="image-label p-3 text-center small fw-semibold w-100">
                                    <i class="bi bi-cloud-arrow-up fs-4 d-block text-primary mb-1"></i> Upload New Images
                                </label>
                                <input id="image-<%= index + 1 %>" type="file" accept="image/*" multiple class="d-none" onchange="initiateCroppingProcess(this, <%= index + 1 %>, <%= index %>)">
                            </div>
                        </div>
                    </div>
                <% }) %>
            </div>

            <div class="mb-5">
                <button type="button" class="btn btn-outline-dark rounded-3 px-4 py-2 small fw-semibold" onclick="appendNewVariantCard(event)">
                    <i class="bi bi-plus-lg me-1"></i> Add Another Variant Card
                </button>
            </div>

            <div class="d-flex justify-content-end gap-3 mt-4 pt-3 border-top">
                <a href="/admin/products" class="btn btn-outline-secondary rounded-3 px-4 py-2 small fw-semibold">Cancel</a>
                <button type="submit" class="btn btn-publish px-5 py-2 fs-6">Save Changes</button>
            </div>
        </form>
    </div>

    <div class="modal fade" id="cropModal" data-bs-backdrop="static" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-md">
            <div class="modal-content border-0 shadow rounded-4">
                <div class="modal-header py-3 bg-light border-bottom rounded-top-4">
                    <h6 class="modal-title fw-bold mb-0 text-dark"><i class="bi bi-crop text-primary me-2"></i>Crop Image</h6>
                </div>
                <div class="modal-body p-3">
                    <div class="cropper-container-modal">
                        <img id="imageToCrop" src="" alt="Source viewport">
                    </div>
                </div>
                <div class="modal-footer py-2 d-flex justify-content-between bg-light border-top rounded-bottom-4">
                    <span class="text-muted small fw-medium" id="croppingProgressText">Image 1 of 1</span>
                    <div>
                        <button type="button" class="btn btn-sm btn-outline-secondary rounded-3 px-3 me-1" onclick="abortCroppingCycle()">Cancel Upload</button>
                        <button type="button" class="btn btn-sm btn-dark rounded-3 px-3" onclick="commitCroppedCanvas()">Crop & Accept</button>
                    </div>
                </div>
            </div>
        </div>
    </div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script>
    let dynamicCroppedFilesMap = {}; 
    let activeFilesQueue = [];
    let activeQueueIndex = 0;
    let targetCardNumberRef = null;
    let targetVariantIndexRef = null;
    let cropperInstance = null;
    let cropModalBootstrap = null;

    let globalVariantCount = <%= product.variants.length %>;

    document.addEventListener("DOMContentLoaded", function() {
        cropModalBootstrap = new bootstrap.Modal(document.getElementById('cropModal'));
    });

    function appendNewVariantCard(event) {
        if (event) event.preventDefault();
        
        globalVariantCount++;
        const currentTrackingIndex = globalVariantCount - 1; 
        const wrapper = document.getElementById("variants-wrapper");
        const variantCardHTML = `
            <div class="variant-card position-relative shadow-sm" id="variant-session-${globalVariantCount}" data-variant-id="new_variant">
                <button type="button" class="btn-close position-absolute top-0 end-0 m-3 small" onclick="removeVariantCard(${globalVariantCount})"></button>
                <div class="row g-3">
                    <div class="col-md-7">
                        <div class="row g-2 mb-2">
                            <div class="col-5"><span class="small fw-semibold text-secondary text-uppercase" style="font-size: 0.75rem;">Attribute type</span></div>
                            <div class="col-5"><span class="small fw-semibold text-secondary text-uppercase" style="font-size: 0.75rem;">Attribute value</span></div>
                            <div class="col-2"></div>
                        </div>
                        <div id="attributes-container-${globalVariantCount}">
                            <div class="row g-2 my-1 attribute-row align-items-center">
                                <div class="col-5">
                                    <input type="text" class="form-control attr-type" placeholder="e.g., Storage" required>
                                </div>
                                <div class="col-5">
                                    <input type="text" class="form-control attr-val" placeholder="e.g., 256GB" required>
                                </div>
                                <div class="col-2 text-center">
                                    <button type="button" class="btn btn-outline-danger btn-sm border-0 rounded-circle" onclick="removeAttributeRow(this, ${globalVariantCount})">
                                        <i class="bi bi-trash3"></i>
                                    </button>
                                </div>
                            </div>
                        </div>
                        <div class="mt-2">
                            <span class="add-attribute-link mt-2" onclick="addAttributeRow(${globalVariantCount})">
                                <i class="bi bi-plus-circle me-1"></i> Add Custom Attribute
                            </span>
                        </div>
                    </div>
                    <div class="col-md-5 border-start border-light-subtle ps-md-4 mt-3 mt-md-0">
                        <div class="mb-3">
                            <label class="small fw-semibold text-secondary text-uppercase d-block mb-1" style="font-size: 0.75rem;">Quantity</label>
                            <div class="input-group" style="width: 150px;"> 
                                <button class="btn btn-outline-secondary" type="button" onclick="stepQuantity(${globalVariantCount}, -1)">-</button>
                                <input type="number" id="quantity-${globalVariantCount}" class="form-control text-center no-spinners target-qty-val" value="1" min="0" required>
                                <button class="btn btn-outline-secondary" type="button" onclick="stepQuantity(${globalVariantCount}, 1)">+</button>
                            </div>
                        </div>
                        <div class="mb-3">
                            <label class="small fw-semibold text-secondary text-uppercase d-block mb-1" style="font-size: 0.75rem;">Price (₹)</label>
                            <input type="number" id="price-${globalVariantCount}" class="form-control target-price-val" placeholder="0.00" min="1" step="any" required>
                        </div>
                    </div>
                </div>
                <div class="mt-4 pt-3 border-top">
                    <p class="fw-semibold small text-secondary text-uppercase mb-2" style="font-size: 0.75rem;">Display Images (Minimum 3 Required)</p>
                    <div class="d-flex flex-wrap gap-3 mb-3 image-row-container" id="imageRow-${globalVariantCount}">
                        <span class="text-muted small no-assets-flag"><i class="bi bi-exclamation-circle text-warning"></i> At least 3 images are mandatory.</span>
                    </div>
                    <div class="d-flex justify-content-start">
                        <label for="image-${globalVariantCount}" class="image-label p-3 text-center small fw-semibold w-100">
                            <i class="bi bi-cloud-arrow-up fs-4 d-block text-primary mb-1"></i> Upload New Images
                        </label>
                        <input id="image-${globalVariantCount}" type="file" accept="image/*" multiple class="d-none" onchange="initiateCroppingProcess(this, ${globalVariantCount}, ${currentTrackingIndex})">
                    </div>
                </div>
            </div>`;       
        wrapper.insertAdjacentHTML('beforeend', variantCardHTML);
    }
    function removeVariantCard(id) {
        const remainingCards = document.querySelectorAll('.variant-card');
        if (remainingCards.length <= 1) {
            Swal.fire({ icon: 'warning', title: 'Action Denied', text: 'A product setup must retain at least one configured active variant.', confirmButtonColor: '#000' });
            return;
        }
        Swal.fire({
            title: 'Remove Variant Block?',
            text: "This specific product configuration block details will be permanently detached.",
            icon: 'warning',
            showCancelButton: true,
            confirmButtonColor: '#dc3545',
            cancelButtonColor: '#6c757d',
            confirmButtonText: 'Remove'
        }).then((result) => {
            if (result.isConfirmed) {
                const targetCard = document.getElementById(`variant-session-${id}`);
                targetCard.remove();
            }
        });
    }
    function addAttributeRow(cardNumber) {
        const targetContainer = document.getElementById(`attributes-container-${cardNumber}`);
        const markup = `
            <div class="row g-2 my-1 attribute-row align-items-center">
                <div class="col-5">
                    <input type="text" class="form-control attr-type" placeholder="e.g., Storage" required>
                </div>
                <div class="col-5">
                    <input type="text" class="form-control attr-val" placeholder="e.g., 256GB" required>
                </div>
                <div class="col-2 text-center">
                    <button type="button" class="btn btn-outline-danger btn-sm border-0 rounded-circle" onclick="removeAttributeRow(this, ${cardNumber})">
                        <i class="bi bi-trash3"></i>
                    </button>
                </div>
            </div>
        `;
        targetContainer.insertAdjacentHTML('beforeend', markup);
    }
    function removeAttributeRow(buttonRef, cardNumber) {
        const container = document.getElementById(`attributes-container-${cardNumber}`);
        const currentRowsCount = container.querySelectorAll('.attribute-row').length;
        if (currentRowsCount <= 1) {
            Swal.fire({
                icon: 'error',
                title: 'Action Restrained',
                text: 'Every product variant requires at least one core attribute. You cannot remove the last row.',
                confirmButtonColor: '#000'
            });
            return;
        }
        buttonRef.closest('.attribute-row').remove();
    }
    function stepQuantity(cardNumber, change) {
        const inputField = document.getElementById(`quantity-${cardNumber}`);
        if (inputField) {
            let currentValue = parseInt(inputField.value, 10) || 0;
            let newValue = currentValue + change;
            if (newValue >= 0) inputField.value = newValue;
        }
    }
   function initiateCroppingProcess(inputRef, cardNumber, variantIndex) {
        if (!inputRef.files || inputRef.files.length === 0) return;
        // Match the strict image criteria from multer validation rules
        const allowedImageMimeTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/webp'];
        const inputFilesArray = Array.from(inputRef.files);
        // Scan array indices to capture documents/PDFs files
       for (let idx = 0; idx < inputFilesArray.length; idx++) {
            if (!allowedImageMimeTypes.includes(inputFilesArray[idx].type)) {
                Swal.fire({
                    icon: "warning", 
                    title: "Unsupported File Format",
                    text: `"${inputFilesArray[idx].name}" is not a valid image format. Only JPEG, JPG, PNG, and WEBP assets are accepted.`,
                    confirmButtonColor: "#000" 
                });
                inputRef.value = ""; 
                activeFilesQueue = []; 
                return; 
            }
        }
        activeFilesQueue = inputFilesArray;
        activeQueueIndex = 0;
        targetCardNumberRef = cardNumber;
        targetVariantIndexRef = variantIndex;
        if (!dynamicCroppedFilesMap[variantIndex]) {
            dynamicCroppedFilesMap[variantIndex] = [];
        }
        launchCropperModalInstance();
        inputRef.value = ""; 
    }
    function launchCropperModalInstance() {
        if (activeQueueIndex >= activeFilesQueue.length) {
            cropModalBootstrap.hide();
            return;
        }
        document.getElementById('croppingProgressText').innerText = `Image ${activeQueueIndex + 1} of ${activeFilesQueue.length}`;
        const file = activeFilesQueue[activeQueueIndex];
        const reader = new FileReader();
        reader.onload = function(e) {
            const imageDOMElement = document.getElementById('imageToCrop');
            imageDOMElement.src = e.target.result;
            cropModalBootstrap.show();
            if (cropperInstance) cropperInstance.destroy();
            cropperInstance = new Cropper(imageDOMElement, {
                aspectRatio: 1,
                viewMode: 1,
                background: false,
                autoCropArea: 0.9
            });
        };
        reader.readAsDataURL(file);
    }
    function commitCroppedCanvas() {
        if (!cropperInstance) return;
        cropperInstance.getCroppedCanvas({ width: 800, height: 800 }).toBlob((blob) => {
            const originalFile = activeFilesQueue[activeQueueIndex];
            const croppedFile = new File([blob], `cropped_${Date.now()}_${originalFile.name}`, { type: 'image/jpeg' });
            dynamicCroppedFilesMap[targetVariantIndexRef].push(croppedFile);
            const rowWrapper = document.getElementById(`imageRow-${targetCardNumberRef}`);
            const alternativeFlag = rowWrapper.querySelector('.no-assets-flag');
            if (alternativeFlag) alternativeFlag.remove();

            const randomId = Math.random().toString(36).substring(2, 9);
            const arrayIndexPosition = dynamicCroppedFilesMap[targetVariantIndexRef].length - 1;

            const livePreviewHtml = `
                <div class="img-wrapper-node staged-cropped-instance" id="staged-preview-${randomId}">
                    <img src="${URL.createObjectURL(croppedFile)}" class="image-preview rounded shadow-sm border border-primary" alt="preview">
                    <button type="button" class="delete-overlay-btn" onclick="removePendingCroppedAsset('${randomId}', ${targetVariantIndexRef}, ${arrayIndexPosition})">
                        <i class="bi bi-x"></i>
                    </button>
                </div>
            `;
            rowWrapper.insertAdjacentHTML('beforeend', livePreviewHtml);

            activeQueueIndex++;
            if (activeQueueIndex < activeFilesQueue.length) {
                launchCropperModalInstance();
            } else {
                cropModalBootstrap.hide();
                if (cropperInstance) cropperInstance.destroy();
            }
        }, 'image/jpeg', 0.9);
    }
    function removePendingCroppedAsset(previewId, variantIdx, storageIdx) {
        document.getElementById(`staged-preview-${previewId}`).remove();
        if (dynamicCroppedFilesMap[variantIdx]) {
            dynamicCroppedFilesMap[variantIdx][storageIdx] = null; 
        }
    }
    function removeExistingSavedAsset(buttonRef) {
        const wrapperNode = buttonRef.closest('.img-wrapper-node');
        const parentContainer = wrapperNode.closest('.image-row-container');
        wrapperNode.remove();
        
        if (parentContainer.querySelectorAll('.img-wrapper-node').length === 0) {
            parentContainer.innerHTML = `<span class="text-muted small no-assets-flag"><i class="bi bi-exclamation-circle text-warning"></i> No files uploaded. At least 3 images required.</span>`;
        }
    }
    function abortCroppingCycle() {
        cropModalBootstrap.hide();
        if (cropperInstance) cropperInstance.destroy();
        activeFilesQueue = [];
    }
    document.getElementById('editProductForm').addEventListener('submit', async function(e) {
        e.preventDefault(); 
        const nameVal = document.getElementById('productNameInput').value.trim();
        const descVal = document.getElementById('productDescInput').value.trim();
        if (!nameVal || !descVal) {
            Swal.fire({ icon: 'error', title: 'Validation Fault', text: 'Device Name and Description are required.' });
            return;
        }
        const variantCards = document.querySelectorAll('.variant-card');
        const variantsData = [];
        let validationFailure = false;
        let errorMessage = "";
        variantCards.forEach((card, index) => {
            if (validationFailure) return;
            const cardNumber = index + 1;
            const variantId = card.getAttribute('data-variant-id');
            const qtyInput = card.querySelector('.target-qty-val');
            const priceInput = card.querySelector('.target-price-val');            
            const quantity = parseInt(qtyInput.value, 10);
            const price = parseFloat(priceInput.value);
            if (isNaN(quantity) || quantity < 0) {
                validationFailure = true;
                errorMessage = `Variant #${cardNumber} needs a valid stock quantity entry.`;
                return;
            }
            if (isNaN(price) || price <= 0) {
                validationFailure = true;
                errorMessage = `Variant #${cardNumber} requires a valid price greater than 0.`;
                return;
            }
            const attrRows = card.querySelectorAll('.attribute-row');
            const attributes = {};
            attrRows.forEach(row => {
                const typeInput = row.querySelector('.attr-type').value.trim();
                const valInput = row.querySelector('.attr-val').value.trim();
                if (typeInput && valInput) attributes[typeInput] = valInput;
            });
            const structuralSavedCount = card.querySelectorAll('.existing-asset-instance').length;
            let stagedNewFilesCount = 0;
            if (dynamicCroppedFilesMap[index]) {
                stagedNewFilesCount = dynamicCroppedFilesMap[index].filter(f => f !== null).length;
            }
            const totalAggregatedImages = structuralSavedCount + stagedNewFilesCount;
            if (totalAggregatedImages < 3) {
                validationFailure = true;
                errorMessage = `Variant #${cardNumber} configuration holds only ${totalAggregatedImages} assets. Keep or add at least 3 images.`;
                return;
            }
            const survivingExistingImages = [];
            card.querySelectorAll('.existing-asset-instance').forEach(node => {
                survivingExistingImages.push(node.getAttribute('data-image-url'));
            });
            variantsData.push({
                id: variantId,
                attributes: attributes,
                quantity: quantity,
                price: price,
                existingImages: survivingExistingImages
            });
        });
        if (validationFailure) {
            Swal.fire({ icon: 'error', title: 'Data Hold', text: errorMessage, confirmButtonColor: '#000' });
            return;
        }
        const formData = new FormData();
        formData.append('name', nameVal);
        formData.append('description', descVal);
        formData.append('category', this.category.value);
        formData.append('brand', 'Apple');   
        formData.append('variantsDataJSON', JSON.stringify(variantsData));
        variantCards.forEach((card, index) => {
            if (dynamicCroppedFilesMap[index]) {
                dynamicCroppedFilesMap[index].forEach((file) => {
                    if (file !== null) {
                        formData.append(`variantImages_${index}`, file);
                    }
                });
            }
        });

        try {
            Swal.fire({ title: 'Updating product entry...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });

            const response = await fetch(this.action, {
                method: 'POST',
                body: formData
            });

            const resData = await response.json().catch(() => ({ success: false }));

            if (response.ok && resData.success !== false) {
                await Swal.fire({
                    icon: 'success',
                    title: 'Product Updated',
                    text: 'The device specifications have been successfully modified.',
                    confirmButtonColor: '#198754'
                });
                window.location.href = '/admin/products';
            } else {
                Swal.fire({
                    icon: 'error',
                    title: 'Database Rejection',
                    text: resData.message || 'The backend application layer rejected this payload layout.',
                    confirmButtonColor: '#dc3545'
                });
            }
        } catch (error) {
            console.error(error);
            Swal.fire({
                icon: 'error',
                title: 'Network Failure',
                text: 'A transmission failure blocked database verification.',
                confirmButtonColor: '#dc3545'
            });
        }
    });
</script>
</body>
</html>