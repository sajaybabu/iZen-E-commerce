<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>iZen | Edit Category</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        :root { --izen-orange: #EF6627; }
        .save-btn { background-color: var(--izen-orange); color: white; border: none; }
        .save-btn:hover { background-color: #d4561f; color: white; }
        .sidebar { transition: transform 0.3s ease; }
        
        @media (max-width: 767.98px) {
            .sidebar {
                position: fixed; top: 56px; left: 0; width: 200px; height: 100vh;
                background-color: #000; color: white; z-index: 1050; transform: translateX(-100%);
            }
            .sidebar.show { transform: translateX(0); }
        }
    </style>
</head>

<body class="bg-light">

    <%- include("../partials/admin/navbar.ejs") %>

    <div class="container-fluid px-4 mt-5">
        <div class="row justify-content-center">
            <div class="col-lg-2 d-none d-lg-block">
                <%- include("../partials/admin/sidebarLinks.ejs") %>
            </div>

            <div class="col-12 col-md-11 col-lg-9">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-header bg-white py-4 border-0">
                        <div class="d-flex align-items-center gap-2">
                            <a href="/admin/category" class="text-secondary text-decoration-none me-2">
                                <i class="bi bi-arrow-left fs-4"></i>
                            </a>
                            <h3 class="fw-bold mb-0">Edit Product Category</h3>
                        </div>
                    </div>

                    <div class="card-body px-4 pb-5">
                        <form action="/admin/EditCategory/<%= categoryId %>" method="POST" id="editCategoryForm">
                            <div class="row justify-content-center">
                                <div class="col-12 col-md-10 col-lg-8">
                                    
                                    <div class="mb-4">
                                        <label for="category" class="form-label fw-semibold text-muted small">Category Name</label>
                                        <input class="form-control form-control-lg border bg-white" id="category" autocomplete="off"
                                            type="text" name="newName" value="<%= editName %>" required>
                                        <p class="text-danger mt-1 mb-0 small" id="categoryMsg"></p>
                                    </div>

                                    <div class="mb-4">
                                        <label for="discount" class="form-label fw-semibold text-muted small">Discount (%)</label>
                                        <input class="form-control form-control-lg border bg-white" id="discount" autocomplete="off"
                                            type="number" name="newDiscount" value="<%= editDiscount || 0 %>" required>
                                        <p class="text-danger mt-1 mb-0 small" id="discountMsg"></p>
                                    </div>

                                    <div class="mb-4">
                                        <label for="description" class="form-label fw-semibold text-muted small">Description</label>
                                        <textarea class="form-control border bg-white" id="description" name="newDescription" rows="4"><%= typeof editDescription !== 'undefined' ? editDescription : '' %></textarea>
                                    </div>

                                    <div class="mb-5">
                                        <label for="status" class="form-label fw-semibold text-muted small">Listed Status</label>
                                        <select class="form-select form-select-lg border bg-white" id="status" name="newStatus" required>
                                            <option value="active" <%= (typeof editStatus !== 'undefined' && editStatus === 'active') ? 'selected' : '' %>>Active (Listed)</option>
                                            <option value="blocked" <%= (typeof editStatus !== 'undefined' && editStatus === 'blocked') ? 'selected' : '' %>>Blocked (Unlisted)</option>
                                        </select>
                                    </div>

                                    <div class="d-flex justify-content-end gap-3 pt-3 border-top">
                                        <a href="/admin/category" class="btn btn-light rounded-pill px-4 py-2">Cancel</a>
                                        <button type="submit" class="btn save-btn rounded-pill px-5 py-2" id="submitBtn">
                                            <i class="bi bi-check-lg me-2"></i>Save Changes
                                        </button>
                                    </div>

                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>

    <script>
        document.getElementById("editCategoryForm").addEventListener('submit', function(event) {
            const category = document.getElementById("category").value.trim();
            const discount = document.getElementById("discount").value.trim();

            const categoryRegex = /^\s*[A-Za-z]+(\s[A-Za-z]+)*\s*$/;
            const discountRegex = /^(100|[0-9]?[0-9])$/;

            const categoryMsg = document.getElementById("categoryMsg");
            const discountMsg = document.getElementById("discountMsg");

            // Client side format assertions before routing payload data
            if (!categoryRegex.test(category)) {
                event.preventDefault();
                categoryMsg.textContent = "Invalid category format. Use letters only.";
                discountMsg.textContent = "";
                return;
            } else if (!discountRegex.test(discount)) {
                event.preventDefault();
                categoryMsg.textContent = "";
                discountMsg.textContent = "Enter a valid percentage rate between 0 and 100";
                return;
            }
        });
    </script>
</body>

</html>