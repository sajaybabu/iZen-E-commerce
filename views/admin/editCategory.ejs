<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>iZen | Edit Category</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <style>
        :root { --izen-orange: #EF6627; }
        .add-user-btn { background-color: var(--izen-orange); }
        .sidebar { transition: transform 0.3s ease; }
        
        @media (max-width: 767.98px) {
            .sidebar {
                position: fixed; top: 56px; left: 0; width: 200px; height: 100vh;
                background-color: #000; color: white; z-index: 1050; transform: translateX(-100%);
            }
            .sidebar.show { transform: translateX(0); }
        }
    </style>
</head>

<body class="bg-light">

    <%- include("../partials/admin/navbar.ejs") %>

    <div class="container-fluid px-4 mt-5">
        <div class="row justify-content-center">
            <div class="col-lg-2 d-none d-lg-block">
                <%- include("../partials/admin/sidebarLinks.ejs") %>
            </div>

            <div class="col-12 col-md-11 col-lg-9">
                <div class="card border-0 shadow-sm rounded-3">
                    <div class="card-body p-5" style="background-color: #ffffff;">
                        <div class="mb-4">
                            <h2 class="fw-bold text-dark">Edit Category</h2>
                            <p class="text-muted small">Update product classification details for the iZen catalog.</p>
                        </div>
                        
                        <form id="editCategoryForm">
                            <div class="row">
                                <div class="col-md-8 mb-4">
                                    <label for="category" class="form-label fw-semibold text-secondary">Category Name</label>
                                    <input class="form-control py-2 border border-secondary-subtle bg-light" id="category" autocomplete="off"
                                        type="text" name="newName" value="<%= category.name %>">
                                    <p class="text-danger mt-1" id="categoryMsg" style="font-size: small;"></p>
                                </div>

                                <div class="col-md-4 mb-4">
                                    <label for="status" class="form-label fw-semibold text-secondary">Listing Status</label>
                                    <select class="form-select py-2 border border-secondary-subtle bg-light" id="status" name="newStatus" required>
                                        <option value="true" <%= category.isListed ? 'selected' : '' %>>Listed (Visible)</option>
                                        <option value="false" <%= !category.isListed ? 'selected' : '' %>>Unlisted (Hidden)</option>
                                    </select>
                                </div>

                                <div class="col-12 mb-4">
                                    <label for="description" class="form-label fw-semibold text-secondary">Description</label>
                                    <textarea class="form-control py-2 border border-secondary-subtle bg-light" id="description" rows="4" name="newDescription" required><%= category.description %></textarea>
                                    <p class="text-danger mt-1" id="descriptionMsg" style="font-size: small;"></p>
                                </div>

                                <div class="col-12 d-flex justify-content-end gap-3 mt-2">
                                    <a href="/admin/category" class="btn btn-dark px-4 rounded-pill text-decoration-none">Cancel</a>
                                    <button type="submit" class="btn btn-primary px-4 rounded-pill" id="submitBtn" style="background-color: var(--izen-orange); border-color: var(--izen-orange);">Save Changes</button>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        // Store the category ID from backend variable safely
        const categoryId = "<%= category._id %>";

        document.getElementById("editCategoryForm").addEventListener('submit', async (event) => {
            event.preventDefault();

            const category = document.getElementById("category");
            const description = document.getElementById("description");
            const status = document.getElementById("status");
            
            const categoryMsg = document.getElementById("categoryMsg");
            const descriptionMsg = document.getElementById("descriptionMsg");

            // Validations
            const categoryRegex = /^\s*[A-Za-z]+(\s[A-Za-z]+)*\s*$/;
            
            // Validate Name
            if (!categoryRegex.test(category.value)) {
                categoryMsg.textContent = "Invalid category name format (letters only)";
                return;
            } else {
                categoryMsg.textContent = "";
            }

            // Validate Description
            if (description.value.trim() === "") {
                descriptionMsg.textContent = "Description field cannot be empty";
                return;
            } else {
                descriptionMsg.textContent = "";
            }

            try {
                // Send update request down to database matching our structural routes
                const response = await fetch(`/admin/editCategory/${categoryId}`, {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ 
                        name: category.value.trim(), 
                        description: description.value.trim(),
                        isListed: status.value === "true"
                    })
                });

                if (response.status === 200) {
                    Swal.fire({
                        title: "Category updated successfully",
                        icon: "success",
                        timer: 1500,
                        showConfirmButton: false
                    }).then(() => {
                        window.location.href = "/admin/category";
                    });
                } else {
                    const data = await response.json();
                    Swal.fire({
                        title: "Failed to update category",
                        text: data.message || "Category name already exists",
                        icon: "error"
                    });
                }
            } catch (err) {
                console.error("Fetch implementation error: ", err);
                Swal.fire({
                    title: "Error",
                    text: "An error occurred while saving modifications",
                    icon: "error"
                });
            }
        });
    </script>
</body>
</html>