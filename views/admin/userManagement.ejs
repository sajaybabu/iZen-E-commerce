<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>User Management | iZen Admin</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <style>
        .add-user-btn { background-color: #EF6627; color: white; border: none; }
        .add-user-btn:hover { background-color: #d4561f; color: white; }
        .sidebar { min-height: 100vh; border-right: 1px solid #ddd; }
        .btn-outline-danger { color: #dc3545; border-color: #f8d7da; background-color: #fff5f5; }
        .btn-outline-danger:hover { background-color: #dc3545; color: white; }
        .btn-outline-success { color: #198754; border-color: #d1e7dd; background-color: #f0fff4; }
        .btn-outline-success:hover { background-color: #198754; color: white; }
        .pagination .page-link { color: #EF6627; }
        .pagination .active .page-link { background-color: #EF6627; border-color: #EF6627; color: white; }
    </style>
</head>
<body>
    <%- include("../partials/admin/navbar.ejs") %>

    <div class="container-fluid">
        <div class="row">
            <!-- Sidebar -->
            <div class="col-md-2 sidebar p-0">
                <%- include("../partials/admin/sidebarLinks.ejs") %>
            </div>

            <!-- Main Content -->
            <div class="col-md-10 p-4">
                <div class="card shadow-sm">
                    <div class="card-header bg-white py-3">
                        <div class="d-flex justify-content-between align-items-center">
                            <!-- SEARCH FORM WITH CLEAR LOGIC -->
                            <form action="/admin/searchUser" method="POST" class="w-50">
                                <div class="input-group">
                                    <input type="text" name="username" class="form-control" placeholder="Search by name or email..." value="<%= search %>">
                                    <button class="btn btn-success" type="submit">
                                        <i class="bi bi-search"></i> Search
                                    </button>
                                    <% if (search && search.length > 0) { %>
                                        <a href="/admin/userManagement" class="btn btn-outline-secondary" title="Clear Search">
                                            <i class="bi bi-x-circle"></i> Clear
                                        </a>
                                    <% } %>
                                </div>
                            </form>
                            
                            <a href="/admin/addUser" class="btn add-user-btn">
                                <i class="bi bi-person-plus-fill"></i> Add New User
                            </a>
                        </div>
                    </div>

                    <div class="card-body p-0">
                        <table class="table table-hover align-middle mb-0">
                            <thead class="table-light">
                                <tr class="text-secondary">
                                    <th class="ps-3">No.</th>
                                    <th>Username</th>
                                    <th>Email</th>
                                    <th>Status</th>
                                    <th class="text-end pe-4">Action</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% if (users && users.length > 0) { %>
                                    <% users.forEach((user, i) => { %>
                                        <tr>
                                            <td class="ps-3 fw-bold"><%= i + 1 %></td>
                                            <td><%= user.username %></td>
                                            <td><%= user.email %></td>
                                            <td>
                                                <% if (user.isBlocked) { %>
                                                    <span class="badge rounded-pill bg-danger">Blocked</span>
                                                <% } else { %>
                                                    <span class="badge rounded-pill bg-success">Active</span>
                                                <% } %>
                                            </td>
                                            <td class="text-end pe-4">
                                                <% if (user.isBlocked) { %>
                                                    <button class="btn btn-sm btn-outline-success px-3" style="min-width: 100px;" onclick="toggleUser('<%= user._id %>', 'unblock')">
                                                        <i class="bi bi-unlock"></i> Unblock
                                                    </button>
                                                <% } else { %>
                                                    <button class="btn btn-sm btn-outline-danger px-3" style="min-width: 100px;" onclick="toggleUser('<%= user._id %>', 'block')">
                                                        <i class="bi bi-slash-circle"></i> Block
                                                    </button>
                                                <% } %>
                                            </td>
                                        </tr>
                                    <% }) %>
                                <% } else { %>
                                    <tr>
                                        <td colspan="5" class="text-center py-5 text-muted">
                                            <i class="bi bi-people d-block mb-2" style="font-size: 2rem;"></i>
                                            No users found.
                                        </td>
                                    </tr>
                                <% } %>
                            </tbody>
                        </table>
                    </div>

                    <!-- PAGINATION -->
                    <div class="card-footer bg-white d-flex justify-content-center border-0 py-3">
                        <nav aria-label="Page navigation">
                            <ul class="pagination mb-0">
                                <li class="page-item <%= prevDisable %>">
                                    <a class="page-link" href="/admin/userManagement?page=<%= prevPage %>">Previous</a>
                                </li>
                                <li class="page-item active">
                                    <span class="page-link"><%= currentPage %></span>
                                </li>
                                <li class="page-item <%= nextDisable %>">
                                    <a class="page-link" href="/admin/userManagement?page=<%= nextPage %>">Next</a>
                                </li>
                            </ul>
                        </nav>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- SCRIPTS -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        async function toggleUser(userId, action) {
            const isBlocking = action === 'block';
            
            const result = await Swal.fire({
                title: isBlocking ? 'Block User?' : 'Unblock User?',
                text: `Are you sure you want to ${action} this user?`,
                icon: 'warning',
                showCancelButton: true,
                confirmButtonColor: isBlocking ? '#dc3545' : '#198754',
                cancelButtonColor: '#6c757d',
                confirmButtonText: isBlocking ? 'Yes, block!' : 'Yes, unblock!'
            });

            if (result.isConfirmed) {
                try {
                    const response = await fetch(`/admin/${action}User`, {
                        method: 'PATCH',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ id: userId })
                    });

                    const data = await response.json();
                    
                    if (data.success) {
                        Swal.fire({
                            title: 'Success!',
                            text: data.message,
                            icon: 'success',
                            timer: 1000,
                            showConfirmButton: false
                        }).then(() => {
                            window.location.reload();
                        });
                    } else {
                        Swal.fire('Error!', data.message || 'Action failed', 'error');
                    }
                } catch (error) {
                    Swal.fire('Error!', 'Network error occurred.', 'error');
                }
            }
        }
    </script>
</body>
</html>