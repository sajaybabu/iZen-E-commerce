<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin - User Management</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">
    <style>
        .test:hover { background-color: rgb(238, 238, 238); }
        .add-user-btn { background-color: #EF6627; }
        .actions { color: #151414; cursor: pointer; }
        .sidebar { transition: transform 0.3s ease; }
        @media (max-width: 767.98px) {
            .sidebar {
                position: fixed; top: 56px; left: 0; width: 200px; height: 100vh;
                background-color: #000; color: white; z-index: 1050; transform: translateX(-100%);
            }
            .sidebar.show { transform: translateX(0); }
        }
    </style>
</head>

<body>
    <%- include("../partials/admin/navbar.ejs") %>

    <div class="container px-0 mt-5">
        <div class="row row-cols-1 justify-content-between">
            <div class="col col-md-3 col-lg-2 border border-secondary rounded text-secondary sidebar align-self-start p-0">
                <%- include("../partials/admin/sidebarLinks.ejs") %>
            </div>

            <div class="card col col-md-8 col-lg-9 px-0 mx-3">
                <div class="card-header">
                    <h1 class="text-center">User Management</h1>
                    <div class="container">
                        <div class="row justify-content-between my-5">
                            <form action="/admin/users/search" class="col-8 col-lg-6 align-self-start d-flex gap-2" method="post">
                                <input class="form-control me-2" name="username" type="search" placeholder="Search by username" aria-label="Search" />
                                <button class="btn btn-outline-success" type="submit">Search</button>
                            </form>
                            <div class="col-4 col-lg-3 d-flex justify-content-end align-self-start">
                                <a role="button" href="/admin/addUser" class="add-user-btn text-light border-0 rounded px-4 py-1 text-decoration-none">Add new</a>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card-body">
                    <% if (users && users.length > 0) { %>
                        <table class="table table-striped">
                            <thead>
                                <tr>
                                    <th>No.</th>
                                    <th>Username</th>
                                    <th>Email</th>
                                    <th>Status</th>
                                    <th>Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                <% users.forEach((user, index)=> { %>
                                    <tr>
                                        <td><%= index+1 %></td>
                                        <td class="py-1"><%= user.username %></td>
                                        <td><%= user.email %></td>
                                        <td>
                                            <% if(!user.isBlocked) { %>
                                                <span class="text-success">Active</span>
                                            <% } else { %>
                                                <span class="text-danger">Blocked</span>
                                            <% } %>
                                        </td>
                                        <td>
                                            <div class="d-flex gap-4">
                                                <% if(!user.isBlocked) { %>
                                                    <a class="actions" onclick='block("<%= user._id%>")' data-bs-toggle="modal" data-bs-target="#blockModal">
                                                        <i class="bi bi-eye"></i>
                                                    </a>
                                                <% } else { %>
                                                    <a class="actions" onclick='unBlock("<%= user._id%>")' data-bs-toggle="modal" data-bs-target="#unBlockModal">
                                                        <i class="bi bi-eye-slash"></i>
                                                    </a>
                                                <% } %>
                                                <a class="actions" onclick='deleteUser("<%= user._id%>")' data-bs-toggle="modal" data-bs-target="#deleteModal">
                                                    <i class="bi bi-trash text-danger"></i>
                                                </a>
                                            </div>
                                        </td>
                                    </tr>
                                <% }) %>
                            </tbody>
                        </table>
                    <% } else { %>
                        <h1 class="text-center mt-5">No user data found</h1>
                    <% } %>
                </div>

                <div class="mb-4 mx-auto">
                    <a href="/admin/users/page/<%= prevPage %>" class="text-light btn bg-secondary rounded border-0 px-3 py-1 <%= prevDisable %>">Prev</a>
                    <a href="/admin/users/page/<%= nextPage %>" class="text-light btn rounded border-0 px-3 py-1 <%= nextDisable %>" style="background-color: #EF6627;">Next</a>
                </div>
            </div>
        </div>
    </div>

    <%- include("../partials/admin/modals.ejs") %> <script>
        let blockId, unBlockId, deleteId;

        function block(id) { blockId = id; }
        function unBlock(id) { unBlockId = id; }
        function deleteUser(id) { deleteId = id; }

        async function confirmBlock() {
            await fetch('/admin/users/blockUser', {
                method: "PATCH",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ id: blockId })
            });
            window.location.reload();
        }

        async function confirmUnBlock() {
            await fetch('/admin/users/unBlockUser', {
                method: "PATCH",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ id: unBlockId })
            });
            window.location.reload();
        }

        async function confirmDelete() {
            await fetch('/admin/users/deleteUser', {
                method: "DELETE",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ id: deleteId })
            });
            window.location.reload();
        }
    </script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>