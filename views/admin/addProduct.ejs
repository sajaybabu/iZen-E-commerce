<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>iZen | Add Product</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.css">
    <style>
        body {
            background-color: #f5f5f7;
            color: #1d1d1f;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }
        .no-spinners::-webkit-outer-spin-button,
        .no-spinners::-webkit-inner-spin-button {
            -webkit-appearance: none;
            margin: 0;
        }
        .no-spinners {
            -moz-appearance: textfield;
        }
        .sidebar {
            transition: transform 0.3s ease;
        }
        .form-control, .form-select {
            border-color: #d2d2d7;
            border-radius: 8px !important;
            padding: 0.6rem 0.9rem;
            font-size: 0.95rem;
            transition: border-color 0.2s ease, box-shadow 0.2s ease;
        }
        .form-control:focus, .form-select:focus {
            border-color: #0071e3;
            box-shadow: 0 0 0 4px rgba(0, 113, 227, 0.15);
        }
        .variant-card {
            border: 1px solid #e5e5ea !important;
            background-color: #ffffff;
            border-radius: 12px;
            padding: 24px;
            margin-bottom: 24px;
            transition: box-shadow 0.2s ease;
        }
        .variant-card:hover {
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.04);
        }
        .image-label {
            border: 2px dashed #0071e3;
            border-radius: 10px;
            cursor: pointer;
            background-color: rgba(0, 113, 227, 0.02);
            transition: background-color 0.2s ease, border-color 0.2s ease;
        }
        .image-label:hover {
            background-color: rgba(0, 113, 227, 0.06);
            border-color: #0077ed;
        }
        .add-attribute-link {
            color: #0071e3;
            font-size: 0.85rem;
            font-weight: 500;
            cursor: pointer;
            display: inline-block;
            text-decoration: none;
        }
        .add-attribute-link:hover {
            text-decoration: underline;
        }
        .btn-black {
            background-color: #1d1d1f;
            color: #ffffff;
            border: none;
            border-radius: 8px;
            padding: 8px 24px;
            font-weight: 500;
            transition: background-color 0.2s ease;
        }
        .btn-black:hover {
            background-color: #333336;
            color: #ffffff;
        }
        .btn-publish {
            background-color: #0071e3;
            color: #ffffff;
            border-radius: 10px;
            border: none;
            font-weight: 600;
            transition: background-color 0.2s ease, transform 0.1s ease;
        }
        .btn-publish:hover {
            background-color: #0077ed;
            color: #ffffff;
        }
        .btn-publish:active {
            transform: scale(0.98);
        }
        @media (max-width: 767.98px) {
            .sidebar {
                position: fixed;
                top: 56px;
                left: 0;
                width: 220px;
                height: 100vh;
                background-color: #1d1d1f;
                color: white;
                z-index: 1050;
                transform: translateX(-100%);
            }
            .sidebar.show {
                transform: translateX(0);
            }
        }
    </style>
</head>
<body>
    <%- include("../partials/admin/navbar.ejs") %>
        <div class="container px-3 px-md-0 mt-4 mb-5">
            <div class="row row-cols-1 justify-content-between mx-0">
                <div class="col col-md-2 col-lg-2 sidebar align-self-start p-0">
                    <%- include("../partials/admin/sidebarLinks.ejs") %>
                </div>
                <div class="card col col-md-9 px-0 mx-md-3 border-0 bg-transparent">
                    <div class="card-body p-4 p-md-5 rounded-4 shadow-sm" style="background-color: #ffffff;" id="card">
                        <form id="productForm">
                            <div class="d-flex align-items-center justify-content-between pb-3 mb-4 border-bottom">
                                <h2 class="m-0 fs-4 fw-bold text-dark" style="letter-spacing: -0.5px;">Add New Product</h2>
                                <span class="badge bg-light text-secondary border px-3 py-2 rounded-pill small">iZen Catalog</span>
                            </div>

                            <div class="container px-0" id="form-container">
                                <div class="row g-4 my-2">
                                    <div class="col-md-6">
                                        <label class="d-block mb-2 fw-semibold small text-uppercase text-secondary" style="letter-spacing: 0.5px;" for="name">Product Name</label>
                                        <input class="form-control" name="name" type="text" id="name" placeholder="e.g. iPhone 15 Pro Max">
                                        <p class="text-danger mt-1 mb-0" id="productNameMsg" style="font-size: 0.8rem;"></p>
                                    </div>
                                    <div class="col-md-6">
                                        <label class="d-block mb-2 fw-semibold small text-uppercase text-secondary" style="letter-spacing: 0.5px;" for="category">Category</label>
                                        <select class="form-select" id="category" name="category">
                                            <option value="" hidden selected>Select Category</option>
                                            <% categories.forEach(function(cat) { %>
                                                <option value="<%= cat.name %>"><%= cat.name %></option>
                                            <% }); %>
                                        </select>
                                        <p class="text-danger mt-1 mb-0" id="categoryMsg" style="font-size: 0.8rem;"></p>
                                    </div>
                                </div>

                                <div class="row g-4 my-2">
                                    <div class="col-12">
                                        <label class="d-block mb-2 fw-semibold small text-uppercase text-secondary" style="letter-spacing: 0.5px;" for="description">Description</label>
                                        <textarea class="form-control" name="description" id="description" rows="4" placeholder="Provide product specifications and overview..."></textarea>
                                        <p class="text-danger mt-1 mb-0" id="descriptionMsg" style="font-size: 0.8rem;"></p>
                                    </div>
                                </div>

                                <div class="col col-md-6 d-none"> 
                                    <select id="brand" name="brand">
                                        <option value="Apple" selected>Apple</option>
                                    </select>
                                </div>

                                <div id="variants-wrapper" class="mt-4 pt-2">
                                    <div class="d-flex align-items-center justify-content-between mb-3">
                                        <h5 class="fw-bold m-0 text-dark fs-5">Product Variants</h5>
                                        <span class="text-muted small">Minimum 1 variant required</span>
                                    </div>

                                    <div class="variant-card position-relative shadow-sm" id="variant-session-1">
                                        <div class="row g-3">
                                            <div class="col-md-7">
                                                <div class="row g-2 mb-2">
                                                    <div class="col-5"><span class="small fw-semibold text-secondary text-uppercase" style="font-size: 0.75rem;">Attribute Type</span></div>
                                                    <div class="col-5"><span class="small fw-semibold text-secondary text-uppercase" style="font-size: 0.75rem;">Attribute Value</span></div>
                                                    <div class="col-2"></div>
                                                </div>
                                                <div id="attributes-container-1">
                                                    <div class="row g-2 my-1 attribute-row align-items-center">
                                                        <div class="col-5">
                                                            <input type="text" class="form-control attr-type" placeholder="e.g. Color">
                                                        </div>
                                                        <div class="col-5">
                                                            <input type="text" class="form-control attr-val" placeholder="e.g. Titanium">
                                                        </div>
                                                        <div class="col-2 text-center">
                                                            <button type="button" class="btn btn-outline-danger btn-sm border-0 rounded-circle" onclick="removeAttributeRow(this, 1)"><i class="bi bi-trash3"></i></button>
                                                        </div>
                                                    </div>
                                                </div>
                                                <span class="add-attribute-link mt-2" onclick="addNewAttributeRow(1)"><i class="bi bi-plus-circle me-1"></i> Add another attribute</span>
                                                <p class="text-danger small targetAttrMsg mt-1" id="attrError-1"></p>
                                            </div>

                                            <div class="col-md-5 border-start border-light-subtle ps-md-4 mt-3 mt-md-0">
                                                <div class="mb-3">
                                                    <label class="small fw-semibold text-secondary text-uppercase d-block mb-1" style="font-size: 0.75rem;">Quantity</label>
                                                    <div class="input-group" style="width: 150px;">
                                                        <button class="btn btn-outline-secondary" type="button" onclick="stepQuantity(1, -1)">-</button>
                                                        <input type="number" id="quantity-1" class="form-control text-center no-spinners" value="1" min="0">
                                                        <button class="btn btn-outline-secondary" type="button" onclick="stepQuantity(1, 1)">+</button>
                                                    </div>
                                                    <p class="text-danger dynamic-msg mt-1 mb-0" id="quantityMsg-1" style="font-size: 0.8rem;"></p>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="small fw-semibold text-secondary text-uppercase d-block mb-1" style="font-size: 0.75rem;">Price (₹)</label>
                                                    <input type="text" id="price-1" class="form-control" placeholder="0.00">
                                                    <p class="text-danger dynamic-msg mt-1 mb-0" id="priceMsg-1" style="font-size: 0.8rem;"></p>
                                                </div>
                                            </div>
                                        </div>

                                        <div class="mt-4 pt-3 border-top">
                                            <div class="d-flex justify-content-between align-items-center mb-2">
                                                <p class="fw-semibold small text-secondary text-uppercase m-0" style="font-size: 0.75rem;">Variant Images (Minimum 3 Required)</p>
                                            </div>
                                            <div class="row row-cols-2 row-cols-md-4 g-3 mb-3" id="imageRow-1"></div>
                                            <div class="d-flex justify-content-start" id="image-input-1">
                                                <label for="image-1" class="image-label p-3 text-center small fw-semibold w-100">
                                                    <i class="bi bi-cloud-arrow-up fs-4 d-block text-primary mb-1"></i> Add Variant Image
                                                </label>
                                                <input id="image-1" type="file" accept="image/*" multiple onchange="newFile(1)" class="d-none">
                                            </div>
                                            <p class="text-danger small mt-1 mb-0" id="imageMsg-1"></p>
                                        </div>

                                        <div class="text-end mt-3 pt-2">
                                            <button type="button" class="btn-black" onclick="saveVariantState(1)">Confirm Variant</button>
                                        </div>
                                    </div>
                                </div>

                                <div class="mb-5">
                                    <button class="btn btn-outline-dark rounded-3 px-4 py-2 small fw-semibold" type="button" onclick="appendVariantCard(event)">
                                        <i class="bi bi-plus-lg me-1"></i> Add More Variant Card
                                    </button>
                                </div>

                                <div class="row justify-content-end mt-4 pt-3 border-top" id="publishBtn">
                                    <div class="col-md-4">
                                        <button type="button" class="btn btn-publish w-100 py-3 fs-6" id="publish">Publish Product</button>
                                    </div>
                                </div>
                            </div>
                        </form>
                    </div>
                </div>
            </div>
        </div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.2/cropper.min.js"></script>
<script>
    const sidebar = document.querySelector('.sidebar');
    const toggleBtn = document.getElementById('menuToggle');
    if (toggleBtn) {
        toggleBtn.addEventListener('click', () => { sidebar.classList.toggle('show'); });
    }

    let variantCount = 1;
    let count = 0;
    let imageCount = {};
    let cropCount = {};
    let croppedBlobs = [];
    let confirmedVariants = {}; 

    function stepQuantity(cardNumber, change) {
        const inputField = document.getElementById(`quantity-${cardNumber}`);
        if (inputField) {
            let currentValue = parseInt(inputField.value, 10) || 0;
            let newValue = currentValue + change;
            if (newValue >= 0) {
                inputField.value = newValue;
            }
        }
    }

    function validateInputBox(inputEl, msgEl, condition, errorMsg) {
        if (!inputEl || condition) {
            msgEl.textContent = errorMsg;
            return false;
        }
        msgEl.textContent = "";
        return true;
    }

    function addNewAttributeRow(variantId) {
        const container = document.getElementById(`attributes-container-${variantId}`);
        if (!container) return;
        const htmlRow = `
        <div class="row g-2 my-1 attribute-row align-items-center">
            <div class="col-5">
                <input type="text" class="form-control attr-type" placeholder="Type here">
            </div>
            <div class="col-5">
                <input type="text" class="form-control attr-val" placeholder="Type here">
            </div>
            <div class="col-2 text-center">
                <button type="button" class="btn btn-outline-danger btn-sm border-0 rounded-circle" onclick="removeAttributeRow(this, ${variantId})"><i class="bi bi-trash3"></i></button>
            </div>
        </div>`;
        container.insertAdjacentHTML('beforeend', htmlRow);
        confirmedVariants[variantId] = false; 
    }

    function removeAttributeRow(button, variantId) {
        const row = button.closest('.attribute-row');
        const container = document.getElementById(`attributes-container-${variantId}`);
        if (container && container.querySelectorAll('.attribute-row').length > 1) {
            row.remove();
            confirmedVariants[variantId] = false;
        } else {
            Swal.fire({ icon: 'warning', title: 'Action Denied', text: 'At least one variant attribute row configuration must remain active.', timer: 2000, showConfirmButton: false });
        }
    }

    function appendVariantCard(event) {
        if (event) event.preventDefault();
        variantCount++;
        const wrapper = document.getElementById("variants-wrapper");
        const variantCardHTML = `
        <div class="variant-card position-relative shadow-sm border" id="variant-session-${variantCount}">
            <button type="button" class="btn-close position-absolute top-0 end-0 m-3 small" onclick="removeVariantCard(${variantCount})"></button>
            <div class="row g-3">
                <div class="col-md-7">
                    <div class="row g-2 mb-2">
                        <div class="col-5"><span class="small fw-semibold text-secondary text-uppercase" style="font-size: 0.75rem;">Attribute Type</span></div>
                        <div class="col-5"><span class="small fw-semibold text-secondary text-uppercase" style="font-size: 0.75rem;">Attribute Value</span></div>
                        <div class="col-2"></div>
                    </div>
                    <div id="attributes-container-${variantCount}">
                        <div class="row g-2 my-1 attribute-row align-items-center">
                            <div class="col-5">
                                <input type="text" class="form-control attr-type" placeholder="Type here">
                            </div>
                            <div class="col-5">
                                <input type="text" class="form-control attr-val" placeholder="Type here">
                            </div>
                            <div class="col-2 text-center">
                                <button type="button" class="btn btn-outline-danger btn-sm border-0 rounded-circle" onclick="removeAttributeRow(this, ${variantCount})"><i class="bi bi-trash3"></i></button>
                            </div>
                        </div>
                    </div>
                    <span class="add-attribute-link mt-2" onclick="addNewAttributeRow(${variantCount})"><i class="bi bi-plus-circle me-1"></i> Add another attribute</span>
                    <p class="text-danger small targetAttrMsg mt-1" id="attrError-${variantCount}"></p>
                </div>
                <div class="col-md-5 border-start border-light-subtle ps-md-4 mt-3 mt-md-0">
                    <div class="mb-3">
                        <label class="small fw-semibold text-secondary text-uppercase d-block mb-1" style="font-size: 0.75rem;">Quantity</label>
                        <div class="input-group" style="width: 150px;">
                            <button class="btn btn-outline-secondary" type="button" onclick="stepQuantity(${variantCount}, -1)">-</button>
                            <input type="number" id="quantity-${variantCount}" class="form-control text-center no-spinners" value="1" min="0">
                            <button class="btn btn-outline-secondary" type="button" onclick="stepQuantity(${variantCount}, 1)">+</button>
                        </div>
                        <p class="text-danger dynamic-msg mt-1 mb-0" id="quantityMsg-${variantCount}" style="font-size: 0.8rem;"></p>
                    </div>
                    <div class="mb-3">
                        <label class="small fw-semibold text-secondary text-uppercase d-block mb-1" style="font-size: 0.75rem;">Price (₹)</label>
                        <input type="text" id="price-${variantCount}" class="form-control" placeholder="0.00">
                        <p class="text-danger dynamic-msg mt-1 mb-0" id="priceMsg-${variantCount}" style="font-size: 0.8rem;"></p>
                    </div>
                </div>
            </div>
            <div class="mt-4 pt-3 border-top">
                <div class="d-flex justify-content-between align-items-center mb-2">
                    <p class="fw-semibold small text-secondary text-uppercase m-0" style="font-size: 0.75rem;">Variant Images (Minimum 3 Required)</p>
                </div>
                <div class="row row-cols-2 row-cols-md-4 g-3 mb-3" id="imageRow-${variantCount}"></div>
                <div class="d-flex justify-content-start" id="image-input-${variantCount}">
                    <label for="image-${variantCount}" class="image-label p-3 text-center small fw-semibold w-100">
                        <i class="bi bi-cloud-arrow-up fs-4 d-block text-primary mb-1"></i> Add Variant Image
                    </label>
                    <input id="image-${variantCount}" type="file" accept="image/*" multiple onchange="newFile(${variantCount})" class="d-none">
                </div>
                <p class="text-danger small mt-1 mb-0" id="imageMsg-${variantCount}"></p>
            </div>
            <div class="text-end mt-3 pt-2">
                <button type="button" class="btn-black" onclick="saveVariantState(${variantCount})">Confirm Variant</button>
            </div>
        </div>`;
        wrapper.insertAdjacentHTML('beforeend', variantCardHTML);
        confirmedVariants[variantCount] = false;
    }

    function removeVariantCard(id) {
        const el = document.getElementById(`variant-session-${id}`);
        if (el) el.remove();
        delete imageCount[id];
        delete cropCount[id];
        delete confirmedVariants[id];
        croppedBlobs = croppedBlobs.filter(blob => blob.variant !== id);
    }

    function saveVariantState(variantNumber) {
        let isCardValid = true;

        const types = document.querySelectorAll(`#attributes-container-${variantNumber} .attr-type`);
        const vals = document.querySelectorAll(`#attributes-container-${variantNumber} .attr-val`);
        const errField = document.getElementById(`attrError-${variantNumber}`);
        
        types.forEach((el, idx) => {
            if (!el.value.trim() || !vals[idx].value.trim()) {
                isCardValid = false;
            }
        });

        if (!isCardValid) {
            errField.textContent = "All attribute type and value input boxes must be filled out completely.";
        } else {
            errField.textContent = "";
        }

        const qtyEl = document.getElementById(`quantity-${variantNumber}`);
        const qtyMsgEl = document.getElementById(`quantityMsg-${variantNumber}`);
        if (!validateInputBox(qtyEl, qtyMsgEl, (!qtyEl.value.trim() || parseInt(qtyEl.value, 10) < 0), "Quantity must be a positive number.")) {
            isCardValid = false;
        }

        const priceEl = document.getElementById(`price-${variantNumber}`);
        const priceMsgEl = document.getElementById(`priceMsg-${variantNumber}`);
        if (!validateInputBox(priceEl, priceMsgEl, (!priceEl.value.trim() || !/^\d+(\.\d{1,2})?$/.test(priceEl.value) || parseFloat(priceEl.value) <= 0), "Enter a valid positive numeric price.")) {
            isCardValid = false;
        }

        const imgMsgEl = document.getElementById(`imageMsg-${variantNumber}`);
        if (!cropCount[variantNumber] || cropCount[variantNumber] < 3) {
            imgMsgEl.textContent = "Minimum 3 image crops are required to confirm this variant card.";
            isCardValid = false;
        } else {
            imgMsgEl.textContent = "";
        }

        if (!isCardValid) {
            confirmedVariants[variantNumber] = false;
            return false;
        }

        confirmedVariants[variantNumber] = true;
        Swal.fire({ icon: 'success', title: 'Card Validated', text: 'Variant input fields passed checks!', timer: 1200, showConfirmButton: false });
        return true;
    }

    function newFile(id) {
        const imageInput = document.getElementById("image-" + id);
        const imageRow = document.getElementById("imageRow-" + id);
        const files = imageInput.files;
        if (!files.length) return;
        
        confirmedVariants[id] = false; 
        
        const allowedImageMimeTypes = ['image/jpeg', 'image/jpg', 'image/png', 'image/webp'];
        let validFilesArray = [];

        for (let idx = 0; idx < files.length; idx++) {
            if (!allowedImageMimeTypes.includes(files[idx].type)) {
                Swal.fire({ 
                    icon: "warning", 
                    title: "Unsupported File Format", 
                    text: `"${files[idx].name}" is not a valid image format. Only JPEG, JPG, PNG, and WEBP assets are accepted.`,
                    confirmButtonColor: "#000", 
                });
                imageInput.value = ''; 
                return; 
            }
            validFilesArray.push(files[idx]);
        }

        let allowedLength = (validFilesArray.length > 5) ? 5 : validFilesArray.length;
        
        for (let i = 0; i < allowedLength; i++) {
            if (imageCount[id] === undefined) imageCount[id] = 0;
            if (imageCount[id] >= 5) {
                Swal.fire({ icon: "warning", title: "Limit Exceeded", text: "Maximum 5 images allowed per variant." });
                break;
            }
            imageCount[id]++;
            if (imageCount[id] >= 5) {
                document.getElementById(`image-input-${id}`).classList.add("d-none");
            }
            count++;
            
            const targetContainerId = `imgContainer${count}`;
            const internalCount = count;
            imageRow.insertAdjacentHTML('beforeend', `
            <div class="position-relative pb-5 col-6 col-md-3 text-center border rounded-3 py-2 bg-white image-track-node" id="${targetContainerId}" data-index="${internalCount}">
                <div class="d-flex gap-1 position-absolute bottom-0 start-50 translate-middle-x mb-2" style="z-index:100; width: 90%;">
                    <button type="button" class="btn btn-dark btn-sm py-1 px-2 w-50" style="font-size:11px;" id="cropperBtn${internalCount}" onclick="cropImg(this, ${id}, ${internalCount})">Crop</button>
                    <button type="button" class="btn btn-danger btn-sm py-1 px-2 w-50" style="font-size:11px;" id="deleteBtn${internalCount}" onclick="deleteImg(this, ${id}, ${internalCount})">Del</button>
                </div> 
            </div>`);
            
            const imgContainer = document.getElementById(targetContainerId);
            const reader = new FileReader();
            reader.onload = (e) => {
                const img = document.createElement('img');
                img.src = e.target.result;
                img.className = 'img-fluid imageContainer rounded-2';
                img.style.maxHeight = '140px';
                img.onload = function () {
                    imgContainer.prepend(img);
                    img.cropperInstance = new Cropper(img, {
                        aspectRatio: 1,
                        viewMode: 1,
                        autoCropArea: 1
                    });
                };
            };
            reader.readAsDataURL(validFilesArray[i]);
        }
        imageInput.value = '';
    }

    async function cropImg(element, variantNumber, targetCountIndex) {
        const container = element.parentElement.parentElement;
        const img = container.querySelector("img");   
        if (!img || !img.cropperInstance) return;
        
        confirmedVariants[variantNumber] = false;
        const cropper = img.cropperInstance;
        const croppedCanvas = cropper.getCroppedCanvas();
        img.src = croppedCanvas.toDataURL('image/jpeg', 0.9);
        img.classList.remove("cropper-hidden");
        
        const cropperContainer = container.querySelector(".cropper-container");
        if (cropperContainer) cropperContainer.classList.add("d-none");
        
        const croppedBlob = await new Promise(resolve => croppedCanvas.toBlob(resolve, "image/jpeg", 0.9));
        croppedBlob.variant = variantNumber;
        croppedBlob.imgIndex = targetCountIndex;
        
        croppedBlobs = croppedBlobs.filter(b => !(b.variant === variantNumber && b.imgIndex === targetCountIndex));
        croppedBlobs.push(croppedBlob);
        
        if (cropCount[variantNumber] === undefined) cropCount[variantNumber] = 1;
        else cropCount[variantNumber]++;
        
        cropper.destroy();
        delete img.cropperInstance;
        element.disabled = true;
    }

    function deleteImg(element, variantNumber, targetCountIndex) {
        confirmedVariants[variantNumber] = false;
        const container = element.parentElement.parentElement;
        const img = container.querySelector("img");        
        if (img && img.cropperInstance) {
            img.cropperInstance.destroy();
        }
        container.remove();
        
        croppedBlobs = croppedBlobs.filter(b => !(b.variant === variantNumber && b.imgIndex === targetCountIndex));
        
        if (imageCount[variantNumber] > 0) imageCount[variantNumber]--;
        if (cropCount[variantNumber] > 0) cropCount[variantNumber]--;
        if (imageCount[variantNumber] < 5) {
            document.getElementById(`image-input-${variantNumber}`).classList.remove("d-none");
        }
    }

    document.getElementById("publish").addEventListener('click', async (event) => {
        event.preventDefault();
        
        const name = document.getElementById("name");
        const description = document.getElementById("description");
        const category = document.getElementById("category");
        
        const productNameMsg = document.getElementById("productNameMsg");
        const descriptionMsg = document.getElementById("descriptionMsg");
        const categoryMsg = document.getElementById("categoryMsg");

        const nameRegex = /^(?!\s*$)(?!\d+$)(?=(?:[^A-Za-z]*[A-Za-z]){3})[A-Za-z0-9][A-Za-z0-9 \-\._+]*$/;
        const descriptionRegex = /^(?=\D*\S)(?=(?:[^A-Za-z]*[A-Za-z]){2}).+$/;

        let isPrimaryFormValid = true;

        if (!validateInputBox(name, productNameMsg, (!name.value.trim() || !nameRegex.test(name.value)), "Field required. Minimum 3 characters containing letters.")) {
            isPrimaryFormValid = false;
        }
        if (!validateInputBox(description, descriptionMsg, (!description.value.trim() || !descriptionRegex.test(description.value)), "Provide a valid description with minimum 2 letters.")) {
            isPrimaryFormValid = false;
        }
        if (!validateInputBox(category, categoryMsg, (category.value === ""), "Please select an active product category from the dropdown menu.")) {
            isPrimaryFormValid = false;
        }

        if (!isPrimaryFormValid) {
            document.getElementById("productForm").scrollIntoView({ behavior: 'smooth' });
            return;
        }

        const activeCards = document.querySelectorAll('.variant-card');
        if (activeCards.length === 0) {
            Swal.fire({ icon: 'warning', title: 'Missing Variants', text: 'Please configure at least one product variant card block before publishing.' });
            return;
        }

        let areAllCardsValid = true;
        let finalVariantsArray = [];
        let seenAttributeCombinations = new Set();
        let duplicateFound = false;
        let duplicateCardElement = null;

        for (let i = 0; i < activeCards.length; i++) {
            const card = activeCards[i];
            const cardId = parseInt(card.id.split('-')[2], 10);
            
            const processingResult = saveVariantState(cardId);
            if (!processingResult) {
                areAllCardsValid = false;
                card.scrollIntoView({ behavior: 'smooth' });
                return;
            }

            const quantityVal = parseInt(document.getElementById(`quantity-${cardId}`).value, 10);
            const priceVal = parseFloat(document.getElementById(`price-${cardId}`).value);
            
            const attributesMap = {};
            const subTypes = card.querySelectorAll('.attr-type');
            const subVals = card.querySelectorAll('.attr-val');
            
            let pairs = [];
            subTypes.forEach((typeInput, idx) => {
                const k = typeInput.value.trim().toLowerCase();
                const v = subVals[idx].value.trim().toLowerCase();
                attributesMap[typeInput.value.trim()] = subVals[idx].value.trim();
                pairs.push(`${k}:${v}`);
            });
            
            pairs.sort();
            const comboIdentifier = pairs.join('|');

            if (seenAttributeCombinations.has(comboIdentifier)) {
                duplicateFound = true;
                duplicateCardElement = card;
                const errField = document.getElementById(`attrError-${cardId}`);
                if (errField) {
                    errField.textContent = "This variant has identical attributes to another configured variant block above. Try a different combination.";
                }
            } else {
                seenAttributeCombinations.add(comboIdentifier);
            }

            finalVariantsArray.push({
                cardDomId: cardId, 
                attributes: attributesMap,
                quantity: quantityVal,
                price: priceVal
            });
        }

        if (duplicateFound) {
            Swal.fire({ 
                icon: 'error', 
                title: 'Duplicate Variants', 
                text: 'Two or more variant cards use the identical attribute combinations. Please correct or remove duplicate settings.' 
            });
            if (duplicateCardElement) {
                duplicateCardElement.scrollIntoView({ behavior: 'smooth' });
            }
            return;
        }

        if (!areAllCardsValid) return;

        const dataPayload = new FormData();
        dataPayload.append('name', name.value.trim());
        dataPayload.append('description', description.value.trim());
        dataPayload.append('category', category.value);
        dataPayload.append('brand', 'Apple');
        dataPayload.append('variantsDataJSON', JSON.stringify(finalVariantsArray));

        finalVariantsArray.forEach((variantObj, variantIndex) => {
            const targetBlobs = croppedBlobs.filter(b => b.variant === variantObj.cardDomId);
            targetBlobs.forEach((blobFile) => {
                dataPayload.append(`variantImages_${variantIndex}`, blobFile, `variant-${variantIndex}-image.jpeg`);
            });
        });

        try {
            Swal.fire({ title: 'Publishing Product...', allowOutsideClick: false, didOpen: () => { Swal.showLoading(); } });
            
            const res = await fetch('/admin/products/add', {
                method: "POST",
                body: dataPayload
            });
            
            const responseData = await res.json().catch(() => ({}));
            
            if (res.ok && responseData.success) {
                Swal.fire({ title: "Success", text: "Product entries added successfully!", icon: "success", timer: 1500 })
                    .then(() => window.location.href = "/admin/products");
            } else {
                Swal.fire({ title: "Validation Notice", text: responseData.message || "Please check that all fields are configured according to specifications.", icon: "error" });
            }
        } catch (err) {
            console.error(err);
            Swal.fire({ title: "Transmission Error", text: "An unexpected connection breakdown occurred during data sync.", icon: "error" });
        }
    });
</script>
</body>
</html>