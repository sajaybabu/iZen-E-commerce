<div class="modal fade" id="deleteModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body px-5">
                <h1 class="fs-2 text-center mt-2 mb-4">Delete User</h1>
                <p class="fs-6 text-center mb-4">Are you sure you want to permanently delete this user?</p>
                <div class="d-flex justify-content-center gap-3 mb-3">
                    <button class="border-0 rounded px-3 py-1 bg-black text-light" data-bs-dismiss="modal">Cancel</button>
                    <button class="border-0 rounded px-3 py-1 text-light" style="background-color: #EF6627;" onclick="confirmDelete()">Confirm</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="blockModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body px-5">
                <h1 class="fs-2 text-center mt-2 mb-4">Block User</h1>
                <p class="fs-6 text-center mb-4">The user will not be able to log in. Proceed?</p>
                <div class="d-flex justify-content-center gap-3 mb-3">
                    <button class="border-0 rounded px-3 py-1 bg-black text-light" data-bs-dismiss="modal">Cancel</button>
                    <button class="border-0 rounded px-3 py-1 text-light" style="background-color: #EF6627;" onclick="confirmBlock()">Confirm</button>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="unBlockModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-body px-5">
                <h1 class="fs-2 text-center mt-2 mb-4">Unblock User</h1>
                <p class="fs-6 text-center mb-4">This will restore the user's access. Proceed?</p>
                <div class="d-flex justify-content-center gap-3 mb-3">
                    <button class="border-0 rounded px-3 py-1 bg-black text-light" data-bs-dismiss="modal">Cancel</button>
                    <button class="border-0 rounded px-3 py-1 text-light" style="background-color: #EF6627;" onclick="confirmUnBlock()">Confirm</button>
                </div>
            </div>
        </div>
    </div>
</div>