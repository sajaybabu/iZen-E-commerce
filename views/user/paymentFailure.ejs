<%- include("../partials/user/shopHeader.ejs") %>

<main class="container py-5 text-center">
    <div class="row justify-content-center">
        <div class="col-md-6">
            <div class="card border-0 shadow-sm p-4 rounded-4">
                <!-- SVG Failure Illustration -->
                <div class="mb-4 text-danger">
                    <svg xmlns="http://www.w3.org/2000/svg" width="80" height="80" fill="currentColor" class="bi bi-x-circle-fill" viewBox="0 0 16 16">
                        <path d="M16 8A8 8 0 1 1 0 8a8 8 0 0 1 16 0zM4.646 4.646a.5.5 0 0 0-.708.708L7.293 8l-3.355 3.346a.5.5 0 0 0 .708.708L8 8.707l3.354 3.347a.5.5 0 0 0 .708-.708L8.707 8l3.347-3.346a.5.5 0 0 0-.708-.708L8 7.293 4.646 4.646z"/>
                    </svg>
                </div>

                <h2 class="fw-bold text-dark">Payment Failed or Cancelled</h2>
                <p class="text-secondary mt-2">
                    We couldn't process your payment. Don't worry—your cart is safe and no money was deducted.
                </p>

                <% if (errorReason) { %>
                    <div class="alert alert-light border text-start fs-7 text-muted my-3">
                        <strong>Reason:</strong> <%= errorReason %>
                    </div>
                <% } %>

                <div class="d-grid gap-2 mt-4">
                    <a href="/checkout" class="btn btn-dark btn-lg rounded-3">Try Payment Again</a>
                    <a href="/cart" class="btn btn-outline-secondary rounded-3">Return to Cart</a>
                </div>
            </div>
        </div>
    </div>
</main>

<%- include('../partials/User/userFooter') %>