<%- include("../partials/user/shopHeader.ejs") %>

<style>
    :root {
        --apple-black: #1d1d1f;
        --apple-gray: #f5f5f7;
        --izen-orange: #ff6b00;
        --izen-orange-hover: #e05e00;
        --success-green: #34c759;
    }

    body {
        background-color: #ffffff;
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        color: var(--apple-black);
    }

    .success-card {
        max-width: 580px;
        margin: 4rem auto;
        padding: 3rem 2rem;
        border-radius: 24px;
        background: #ffffff;
        border: 1px solid #e5e5ea;
        box-shadow: 0 8px 30px rgba(0, 0, 0, 0.04);
        text-align: center;
    }

    /* Minimalist Elegant Success Checkmark Illustration Banner */
    .illustration-wrapper {
        position: relative;
        width: 100px;
        height: 100px;
        margin: 0 auto 2rem auto;
        background: rgba(52, 199, 89, 0.1);
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .checkmark-icon {
        font-size: 3rem;
        color: var(--success-green);
        animation: scaleIn 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275) forwards;
    }

    .order-id-badge {
        background-color: var(--apple-gray);
        color: var(--apple-black);
        font-family: var(--bs-font-monospace);
        padding: 6px 16px;
        border-radius: 20px;
        font-size: 0.9rem;
        font-weight: 600;
        display: inline-block;
    }

    .btn-izen-primary {
        background-color: var(--izen-orange);
        color: white;
        border: none;
        transition: background-color 0.2s ease;
    }

    .btn-izen-primary:hover {
        background-color: var(--izen-orange-hover);
        color: white;
    }

    @keyframes scaleIn {
        0% { transform: scale(0); opacity: 0; }
        100% { transform: scale(1); opacity: 1; }
    }
</style>

<div class="container">
    <div class="success-card">
        <div class="illustration-wrapper">
            <i class="bi bi-check-circle-fill checkmark-icon"></i>
        </div>

        <h2 class="fw-bold tracking-tight mb-2">Thank You for Your Order!</h2>
        <p class="text-muted px-4 mb-4" style="font-size: 0.95rem; line-height: 1.5;">
            Your transaction was processed successfully. We are preparing your ecosystem devices for delivery and will send tracking updates directly to your email.
        </p>

        <div class="mb-5">
            <span class="text-muted d-block small mb-1.5 text-uppercase tracking-wider fw-bold">Order Reference ID</span>
            <span class="order-id-badge"><%= orderId %></span>
        </div>

        <div class="d-flex flex-column flex-sm-row justify-content-center gap-3 px-4">
    <a href="/checkout/orders/my-orders" class="btn btn-dark rounded-pill px-4 py-2.5 fw-bold" style="font-size: 0.85rem;">
        <i class="bi bi-box-seam me-2"></i> View Order Details
    </a>
    <a href="/allProducts" class="btn btn-outline-secondary rounded-pill px-4 py-2.5 fw-bold" style="font-size: 0.85rem;">
        Continue Shopping <i class="bi bi-arrow-right ms-2"></i>
    </a>
</div>
    </div>
</div>

<%- include('../partials/User/userFooter') %>