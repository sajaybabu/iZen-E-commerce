<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>iZen Cart Ecosystem</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Titillium+Web:wght@300;400;600;700&display=swap" rel="stylesheet">
    <style>
        html,
        body {
            height: 100%;
            font-family: "Titillium Web", sans-serif;
        }

        body {
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }

        .main-content {
            flex: 1 0 auto;
        }

        footer {
            flex-shrink: 0;
        }

        .cart-item {
            border-bottom: 1px solid #f1f1f1;
            padding: 1.5rem 0;
            transition: all 0.2s ease;
        }

        .cart-item.invalid-row {
            background-color: #fff5f5;
            border-left: 4px solid #dc3545;
        }

        .cart-item:last-child {
            border-bottom: none;
        }

        .quantity-btn {
            cursor: pointer;
            user-select: none;
        }

        .subtotal-price {
            font-weight: 600;
            color: #111111;
        }

        .btn-proceed {
            background-color: #111111;
            border: none;
            padding: 0.75rem 2rem;
            font-weight: 600;
            letter-spacing: 0.5px;
            transition: background 0.2s ease;
        }

        .btn-proceed:hover:not([disabled]) {
            background-color: #2b2b2b;
        }

        .btn-proceed:disabled {
            background-color: #6c757d;
            cursor: not-allowed;
            opacity: 0.65;
        }

        .navbar {
            padding: 0.8rem 1rem;
        }

        .navbar-brand {
            font-weight: 700;
            font-size: 1.4rem;
            letter-spacing: 1px;
        }

        .nav-link:hover {
            color: #888888 !important;
        }
        
        .cursor-pointer {
            cursor: pointer;
        }
    </style>
</head>

<body class="bg-light">

    <nav class="navbar navbar-expand-lg bg-black shadow-sm">
        <div class="container">
            <a class="navbar-brand text-light d-flex align-items-center" href="/">
                <i class="bi bi-apple me-2"></i> iZen
            </a>
            <button class="navbar-toggler bg-light" type="button" data-bs-toggle="collapse" data-bs-target="#navbarContent">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarContent">
                <ul class="navbar-nav mx-auto text-center mb-2 mb-lg-0">
                    <li class="nav-item"><a class="nav-link text-light" href="/">Home</a></li>
                    <li class="nav-item"><a class="nav-link text-light" href="/allProducts">Shop</a></li>
                </ul>

                <div class="d-lg-flex flex-column flex-lg-row align-items-center gap-5">
                    <div class="d-flex align-items-center justify-content-center gap-5 mt-lg-0 mt-3 mb-3 mb-lg-1">
                        <a href="/wishlist" class="text-light fs-5"><i class="bi bi-heart"></i></a>
                        <a href="/cart" class="text-light fs-5"><i class="bi bi-cart3"></i></a>
                        <a href="/profile" class="text-light fs-5"><i class="bi bi-person-circle"></i></a>
                    </div>
                    <div class="d-flex justify-content-center">
                        <a href="/logout" class="btn btn-sm btn-outline-light px-3">Logout</a>
                    </div>
                </div>
            </div>
        </div>
    </nav>

    <% if(cart && cart.items && cart.items.length > 0){ %>
        <div class="main-content">
            <div class="container py-5">
                
                <% if (!checkoutReady) { %>
                    <div class="alert alert-danger d-flex align-items-center mb-4 shadow-sm" role="alert">
                        <i class="bi bi-exclamation-triangle-fill me-2 fs-5"></i>
                        <div>
                            <strong>Cannot Proceed:</strong> Some items in your cart are unavailable or out of stock. Please remove them to checkout.
                        </div>
                    </div>
                <% } %>

                <div class="row">
                    <div class="col-lg-8">
                        <div class="bg-white rounded-3 shadow-sm p-2">
                            <div class="table-responsive">
                                <table class="table table-borderless align-middle mb-0">
                                    <thead class="text-muted border-bottom">
                                        <tr>
                                            <th>Product</th>
                                            <th>Specs</th>
                                            <th>Price</th>
                                            <th class="text-center">Quantity</th>
                                            <th>Subtotal</th>
                                            <th></th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        <% let totalPrice = 0 %>
                                        <% cart.items.forEach((ele, index) => { %>
                                            <% 
                                                const product = ele.productDoc;
                                                const variant = ele.variantDoc;
                                                const currentVariantId = ele.variantId || ele.variant;
                                                
                                                const isRowInvalid = ele.isInvalid || !variant || !product || product.isBlocked || product.isDeleted || variant.quantity <= 0 || ele.quantity > variant.quantity;
                                            %>
                                            
                                            <tr class="cart-item <%= isRowInvalid ? 'invalid-row' : '' %>" id="tableRow-<%= index %>">
                                                <td>
                                                    <div class="d-flex align-items-center">
                                                        <img src="<%= (variant && variant.images && variant.images.length > 0) ? variant.images[0] : ((product && product.images && product.images.length > 0) ? product.images[0] : '/uploads/default-ios.jpg') %>"
                                                             alt="<%= product ? product.name : 'Device' %>" class="rounded-3 me-3 border" width="75">
                                                        <div>
                                                            <h6 class="mb-0 fw-semibold text-dark"><%= product ? product.name : 'Unknown Product' %></h6>
                                                            
                                                            <% if (!variant || !product || product.isBlocked || product.isDeleted) { %>
                                                                <span class="badge bg-danger mt-1">Currently Unavailable</span>
                                                            <% } else if (variant.quantity <= 0) { %>
                                                                <span class="badge bg-danger mt-1">Out of Stock</span>
                                                            <% } else if (ele.quantity > variant.quantity) { %>
                                                                <span class="badge bg-warning text-dark mt-1">Only <%= variant.quantity %> left in stock</span>
                                                            <% } %>
                                                        </div>
                                                    </div>
                                                </td>
                                                <td class="text-muted small">
                                                    <% if (variant && variant.attributes) { %>
                                                        <% if (variant.attributes.ram) { %> RAM: <%= variant.attributes.ram %>GB <% } %>
                                                        <% if (variant.attributes.storage) { %> Storage: <%= variant.attributes.storage %> <% } %>
                                                        <% if (variant.attributes.color) { %> Color: <span class="text-capitalize"><%= variant.attributes.color %></span> <% } %>
                                                    <% } else if (variant) { %>
                                                        <%= variant.ram || '' %> RAM / <%= variant.storage || '' %> / <span class="text-capitalize"><%= variant.color || 'Standard' %></span>
                                                    <% } else { %>
                                                        --
                                                    <% } %>
                                                </td>
                                                
                                                <td>
                                                    <% if (variant) { %>
                                                        &#8377;<%= variant.price.toLocaleString('en-IN') %>
                                                    <% } else { %>
                                                        &#8377;0
                                                    <% } %>
                                                </td>

                                                <td>
                                                    <div class="d-flex align-items-center justify-content-center input-group mx-auto" style="max-width: 110px;">
                                                        <button type="button" class="quantity-btn input-group-text bg-dark text-light border-0 py-1 px-2"
                                                            <%= isRowInvalid && (!variant || variant.quantity <= 0) ? 'disabled style="opacity:0.5;"' : '' %>
                                                            onclick='updateQuantityCount(this, "decrement", "<%= currentVariantId %>", "<%= index %>", "<%= variant ? variant.price : 0 %>")'>-</button>
                                                        
                                                        <input type="text" id="quantity-<%= index %>" class="quantity-input form-control text-center bg-white px-0 py-1 border" 
                                                               value="<%= ele.quantity %>" readonly>
                                                        
                                                        <button type="button" class="quantity-btn input-group-text bg-dark text-light border-0 py-1 px-2"
                                                            <%= isRowInvalid && (!variant || variant.quantity <= 0) ? 'disabled style="opacity:0.5;"' : '' %>
                                                            onclick='updateQuantityCount(this, "increment", "<%= currentVariantId %>", "<%= index %>", "<%= variant ? variant.price : 0 %>")'>+</button>
                                                    </div>
                                                </td>

                                                <td>
                                                    <% 
                                                        let itemSubtotal = 0;
                                                        if (variant && product && !product.isBlocked && !product.isDeleted) {
                                                            itemSubtotal = variant.price * ele.quantity;
                                                            if (variant.quantity >= ele.quantity) {
                                                                totalPrice += itemSubtotal;
                                                            }
                                                        }
                                                    %>
                                                    <span class="subtotal-price" id="subTotal-<%= index %>">
                                                        &#8377;<%= itemSubtotal.toLocaleString('en-IN') %>
                                                    </span>
                                                </td>
                                                <td class="text-end">
                                                    <i class="bi bi-trash3 text-muted cursor-pointer hover-danger fs-5 me-2" 
                                                       onclick='removeProductFromEcosystem("<%= currentVariantId %>")'></i>
                                                </td>
                                            </tr>        
                                        <% }) %>
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    </div>

                    <div class="col-lg-4 mt-4 mt-lg-0">
                        <div class="bg-white rounded-3 shadow-sm p-4 sticky-top" style="top: 1.5rem; z-index: 10;">
                            <h5 class="fw-bold text-dark border-bottom pb-3 mb-3">Order Summary</h5>
                            <div class="d-flex justify-content-between align-items-center mb-3">
                                <span class="text-muted">Total Price:</span>
                                <span id="totalPrice" class="fs-5 fw-bold text-dark">&#8377;<%= totalPrice.toLocaleString('en-IN') %></span>
                            </div>
                            <p class="text-muted small bg-light p-2 rounded border mb-3">
                                <i class="bi bi-shield-check me-1 text-success"></i> Secure checkout powered by iZen.
                            </p>
                            
                            <% if (checkoutReady) { %>
                               <a href="/cart/checkout" class="btn btn-proceed text-white w-100 py-2 fw-bold" style="background-color: #111;">
                               Proceed to Checkout
                                </a>
                            <% } else { %>
                             <button class="btn btn-secondary w-100 py-2 fw-bold" disabled style="cursor: not-allowed; background-color: #6c757d; color: #fff;">
                                    Remove Unavailable Items to Checkout
                            </button>
                            <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    <% } else { %>
        <div class="main-content d-flex align-items-center justify-content-center px-5 pb-5 pt-0" style="min-height: 65vh;">
            <div class="text-center">
                <div class="mb-4">
                    <i class="bi bi-apple text-muted opacity-25" style="font-size: 5.5rem;"></i>
                </div>
                <h4 class="fw-bold text-dark mb-2">Your cart is empty</h4>
                <p class="text-muted mb-4">Explore our products to find something you like.</p>
                <a href="/allProducts" class="btn btn-proceed text-white px-4 py-2.5 rounded-2 shadow-sm">
                    <i class="bi bi-arrow-left me-2"></i> Browse Products
                </a>
            </div>
        </div>
    <% } %>

    <footer class="bg-black text-secondary text-center py-4 mt-auto border-top border-dark">
        <p class="mb-0 small">© 2026 iZen Inc. All rights reserved.</p>
    </footer>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    
    <script>
        async function updateQuantityCount(buttonElement, operationalAction, variantId, elementsIndex, originalUnitPrice) {
            const inputContainer = buttonElement.parentElement.querySelector('.quantity-input');
            const currentQuantityVal = parseInt(inputContainer.value);

            if (currentQuantityVal <= 1 && operationalAction === 'decrement') {
                Swal.fire({ icon: "warning", title: "Quantity Limit", text: "Minimum limit reached. Remove the item using the delete icon.", confirmButtonColor: "#111" });
                return;
            }
            if (currentQuantityVal >= 5 && operationalAction === 'increment') {
                Swal.fire({ icon: "warning", title: "Quantity Limit", text: "You can add a maximum of 5 units per item.", confirmButtonColor: "#111" });
                return;
            }

            try {
                const response = await fetch('/cart/update-quantity', {
                    method: "PUT",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ variantId, action: operationalAction })
                });
                
                const result = await response.json();

                if (response.ok && result.success) {
                    let alteredValue = operationalAction === 'increment' ? currentQuantityVal + 1 : currentQuantityVal - 1;
                    inputContainer.value = alteredValue;

                    const dynamicSubtotal = alteredValue * parseFloat(originalUnitPrice);
                    document.getElementById(`subTotal-${elementsIndex}`).innerHTML = `&#8377;${dynamicSubtotal.toLocaleString('en-IN')}`;

                    window.location.reload();
                } else {
                    Swal.fire({ icon: "error", title: "Out of Stock", text: result.message || "Requested quantity is not available.", confirmButtonColor: "#111" });
                }
            } catch (err) {
                console.error("Cart update tracking intercept error: ", err);
                Swal.fire({ icon: "error", title: "Error", text: "Something went wrong. Please check your network connection.", confirmButtonColor: "#111" });
            }
        }

        function removeProductFromEcosystem(variantId) {
            if (!variantId) {
                Swal.fire({ icon: "error", title: "Error", text: "Invalid item ID.", confirmButtonColor: "#111" });
                return;
            }

            Swal.fire({
                title: "Remove Item?",
                text: "Are you sure you want to remove this item from your cart?",
                icon: "question",
                showCancelButton: true,
                confirmButtonColor: "#111",
                cancelButtonColor: "#6c757d",
                confirmButtonText: "Yes, remove it"
            }).then(async (choice) => {
                if (choice.isConfirmed) {
                    try {
                        const response = await fetch(`/cart/remove/${variantId}`, {
                            method: "DELETE",
                            headers: { "Content-Type": "application/json" }
                        });

                        if (response.ok) {
                            window.location.reload();
                        } else {
                            Swal.fire({ icon: "error", title: "Error", text: "Failed to remove the item.", confirmButtonColor: "#111" });
                        }
                    } catch (error) {
                        console.error(error);
                        Swal.fire({ icon: "error", title: "Error", text: "Something went wrong. Please try again.", confirmButtonColor: "#111" });
                    }
                }
            });
        }
    </script>
</body>

</html>