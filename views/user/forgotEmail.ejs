<!doctype html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>iZen — Forgot Password</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        :root {
            --bg: #f4f6fb;
            --card: #ffffff;
            --accent: #e35f00; 
            --muted: #6b7280;
            --success: #16a34a;
            --danger: #dc2626;
            font-family: -apple-system, system-ui, sans-serif;
        }
        html, body { height: 100%; margin: 0; background: var(--bg); }
        .container { min-height: 100vh; display: flex; align-items: center; justify-content: center; padding: 24px; }
        .card { width: 100%; max-width: 450px; background: var(--card); border-radius: 18px; box-shadow: 0 8px 30px rgba(0,0,0,0.04); padding: 40px; display: flex; flex-direction: column; gap: 20px; }
        .btn-primary { background: var(--accent); color: #fff; border: none; padding: 12px; border-radius: 10px; font-weight: 600; }
        input[type="email"] { padding: 12px; border-radius: 10px; border: 1px solid #d2d2d7; outline: none; }
    </style>
</head>

<body>
    <div class="container">
        <form method="post" action="/forgot-password" class="card" id="forgotForm" novalidate>
            <div class="brand">
                <div>
                    <h1 style="font-weight: 700; letter-spacing: -0.5px;">iZen</h1>
                    <h2 style="font-size: 1.2rem; margin-top: 10px;">Reset Password</h2>
                    <p style="color: var(--muted); font-size: 14px;">Enter the email address associated with your account.</p>
                </div>
            </div>

            <div class="input-group" style="display: flex; flex-direction: column; gap: 8px;">
                <label for="email" style="font-weight: 600; font-size: 13px;">Email address</label>
                <input id="email" name="email" type="email" placeholder="name@example.com" autocomplete="email" required />
            </div>

            <div id="feedback" aria-live="polite" style="display:none"></div>

            <div class="actions" style="display: flex; gap: 12px; margin-top: 10px;">
                <button type="submit" class="btn btn-primary" id="submitBtn" style="flex: 2;">Send Verification Code</button>
                <button type="button" class="btn" id="cancelBtn" style="flex: 1; background: #eee; border-radius: 10px;">Cancel</button>
            </div>
        </form>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>
        (function () {
            const form = document.getElementById('forgotForm');
            const email = document.getElementById('email');
            const feedback = document.getElementById('feedback');

            function showMessage(type, text) {
                feedback.style.display = 'block';
                feedback.style.color = type === 'success' ? '#16a34a' : '#dc2626';
                feedback.style.fontSize = '13px';
                feedback.textContent = text;
            }

            form.addEventListener('submit', async function (ev) {
                ev.preventDefault();
                const rawEmail = email.value.trim();

                if (rawEmail === '') {
                    showMessage('error', 'Please enter your email address.');
                    return;
                }

                try {
                    const response = await fetch('/forgot-password', {
                        method: "POST",
                        headers: { "Content-Type": "application/json" },
                        body: JSON.stringify({ email: rawEmail })
                    });

                    if (response.ok) {
                        window.location.href = "/forgot-password-otp";
                    } else {
                        const data = await response.json();
                        Swal.fire({
                            icon: "error",
                            title: "Account Not Found",
                            text: data.message || "This email is not registered with iZen.",
                            confirmButtonColor: '#0071e3'
                        });
                    }
                } catch (error) {
                    console.error("Error:", error);
                }
            });

            document.getElementById('cancelBtn').addEventListener('click', () => {
                window.location.href = "/login";
            });
        })();
    </script>
</body>
</html>