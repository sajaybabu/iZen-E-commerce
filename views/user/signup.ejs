<!DOCTYPE html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Welcome to iZen</title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet" />
  <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <style>
    * {
      margin: 0;
      padding: 0;
      box-sizing: border-box;
    }

    html, body {
      font-family: "Inter", sans-serif;
      background-color: #fff;
      min-height: 100vh;
      overflow-y: auto;
    }

    .main-container {
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    .welcome-title {
      display: flex;
      justify-content: center;
      align-items: center;
      gap: 8px;
      padding: 20px 0;
    }

    .welcome-title .welcome-text {
      font-size: 1.4rem;
      color: #333;
      margin-top: 14px;
    }

    .welcome-title .brand-name {
      font-weight: 600;
      font-size: 1.6rem;
      color: #333;
      margin-top: 14px;
    }

    .logo-icon {
      width: 70px;
      height: auto;
      display: block;
    }

    .content-wrapper {
      flex: 1;
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .illustration-img {
      max-width: 100%;
      height: auto;
      max-height: 500px;
      padding-left: 10px;
    }

    .form-section {
      padding: 30px;
      width: 100%;
      max-width: 380px;
      border: 1px solid #e0e0e0;
      border-radius: 12px;
      background-color: #fff;
      box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    }

    .form-section h5 {
      color: #1a1a1a;
      font-size: 0.95rem;
      margin-bottom: 20px;
      font-weight: 700;
      padding-bottom: 10px;
      border-bottom: 1px solid #f0f0f0;
      text-decoration: none;
    }

    .form-control {
      border: none;
      border-bottom: 1px solid #ccc;
      border-radius: 0;
      padding: 10px 0;
      font-size: 0.85rem;
      background: transparent;
      transition: border-color 0.3s ease;
    }

    .form-control:focus {
      box-shadow: none;
      border-bottom-color: #1a1a1a;
      background: transparent;
    }

    .input-error {
      border-bottom: 1px solid #dc3545 !important;
    }

    .password-wrapper {
      position: relative;
      width: 100%;
    }

    .toggle-password {
      position: absolute;
      right: 5px;
      top: 12px;
      cursor: pointer;
      color: #888;
      font-size: 1rem;
      z-index: 10;
    }

    .error-msg {
      font-size: 0.7rem;
      color: #dc3545;
      display: block;
      margin-top: 2px;
    }

    .validation-hint {
      font-size: 0.65rem;
      color: #dc3545;
      margin-top: 3px;
      display: none; /* Controlled cleanly via JS display state */
      line-height: 1.25;
    }

    .validation-hint.visible {
      display: block;
    }

    .btn-create-account {
      background-color: #1a1a1a;
      color: #fff;
      border-radius: 25px;
      padding: 12px 30px;
      font-size: 0.9rem;
      font-weight: 500;
      width: 100%;
      margin-top: 10px;
      border: none;
      transition: background 0.2s;
    }

    .btn-create-account:hover {
      background-color: #000;
      color: #fff;
    }

    .btn-google {
      background-color: #fff;
      color: #333;
      border: 1px solid #ddd;
      border-radius: 25px;
      padding: 10px 30px;
      font-size: 0.85rem;
      width: 100%;
      margin-top: 12px;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 10px;
      text-decoration: none;
    }

    .login-link {
      text-align: center;
      margin-top: 18px;
      color: #666;
      font-size: 0.8rem;
    }

    .login-link a {
      color: #1a1a1a;
      text-decoration: underline;
      font-weight: 600;
    }

    .mb-custom {
      margin-bottom: 0.75rem;
    }
  </style>
</head>

<body>
  <div class="main-container">
    <div class="welcome-title">
      <span class="welcome-text">welcome to</span>
      <span class="brand-name">iZen</span>
      <img src="/images/blackkkkk.png" alt="iZen Logo" class="logo-icon" />
    </div>

    <div class="content-wrapper">
      <div class="container-fluid">
        <div class="row justify-content-center align-items-center">
          <div class="col-lg-4 col-md-5 d-none d-md-flex justify-content-center">
            <img src="/images/signup.png" alt="Sign up illustration" class="illustration-img" />
          </div>

          <div class="col-lg-3 col-md-5 col-sm-8 col-11">
            <div class="form-section">
              <h5>Enter your details below</h5>

              <% if (locals.error) { %>
                <div class="alert alert-danger py-2 px-3 mb-3" style="font-size: 0.75rem; border-radius: 8px;">
                  <i class="bi bi-exclamation-circle me-2"></i><%= error %>
                </div>
              <% } %>

              <form action="/signup" method="POST" id="registerForm" novalidate>
                <div class="mb-custom">
                  <input type="text" class="form-control" name="username" id="username" placeholder="User name">
                  <small id="usernameError" class="error-msg"></small>
                </div>
                
                <div class="mb-custom">
                  <input type="email" class="form-control" name="email" id="email" placeholder="Email">
                  <small id="emailError" class="error-msg"></small>
                </div>
                
                <div class="mb-custom">
                  <input type="tel" class="form-control" name="phone" id="phone" placeholder="Phone">
                  <small id="phoneError" class="error-msg"></small>
                </div>
                
                <div class="mb-custom password-wrapper">
                  <input type="password" class="form-control" name="password" id="password" placeholder="Password">
                  <i class="bi bi-eye toggle-password" id="togglePassword"></i>
                  <small id="passwordError" class="error-msg"></small>
                  <small id="passHint" class="validation-hint">
                    Must have 8+ characters, one uppercase letter, and one special character.
                  </small>
                </div>

                <div class="mb-custom password-wrapper">
                  <input type="password" class="form-control" name="confirmPassword" id="confirmPassword" placeholder="Confirm Password">
                  <i class="bi bi-eye toggle-password" id="toggleConfirmPassword"></i>
                  <small id="confirmPasswordError" class="error-msg"></small>
                </div>

                <div class="mb-custom">
                  <input type="text" class="form-control text-uppercase" name="referralCode" id="referralCode" placeholder="Referral Code (Optional)">
                  <small id="referralCodeError" class="error-msg"></small>
                </div>
                
                <button type="submit" class="btn btn-create-account">Create Account</button>
              </form>

              <a href="/auth/google" class="btn btn-google">
                <img src="https://www.google.com/favicon.ico" width="16" alt="Google" /> Sign up with Google
              </a>

              <p class="login-link">Already have account? <a href="/login">Log in</a></p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>

  <script>
    document.addEventListener("DOMContentLoaded", function () {
      const form = document.getElementById('registerForm');
      const passwordInput = document.getElementById('password');
      const confirmPasswordInput = document.getElementById('confirmPassword');
      const togglePassword = document.getElementById('togglePassword');
      const toggleConfirmPassword = document.getElementById('toggleConfirmPassword');
      const passHint = document.getElementById('passHint');
      const referralInput = document.getElementById('referralCode');

      const urlParams = new URLSearchParams(window.location.search);
      const refParam = urlParams.get('ref');
      if (refParam) {
        referralInput.value = refParam.toUpperCase();
      }

      // Password Toggles
      togglePassword.addEventListener('click', function () {
        const isPassword = passwordInput.getAttribute('type') === 'password';
        passwordInput.setAttribute('type', isPassword ? 'text' : 'password');
        this.classList.toggle('bi-eye');
        this.classList.toggle('bi-eye-slash');
      });

      toggleConfirmPassword.addEventListener('click', function () {
        const isPassword = confirmPasswordInput.getAttribute('type') === 'password';
        confirmPasswordInput.setAttribute('type', isPassword ? 'text' : 'password');
        this.classList.toggle('bi-eye');
        this.classList.toggle('bi-eye-slash');
      });

      // Dynamic Password Hint Logic
      passwordInput.addEventListener('input', function () {
        const strongPasswordRegex = /^(?=.*[A-Z])(?=.*[!@#$%^&*])(?=.{8,})/;
        
        if (this.value.length > 0 && !strongPasswordRegex.test(this.value)) {
          passHint.classList.add('visible');
          this.classList.add('input-error');
        } else {
          passHint.classList.remove('visible');
          this.classList.remove('input-error');
          document.getElementById('passwordError').innerText = "";
        }

        if (confirmPasswordInput.value.length > 0 && confirmPasswordInput.value !== this.value) {
          document.getElementById('confirmPasswordError').innerText = "Passwords do not match";
          confirmPasswordInput.classList.add('input-error');
        } else if (confirmPasswordInput.value === this.value) {
          document.getElementById('confirmPasswordError').innerText = "";
          confirmPasswordInput.classList.remove('input-error');
        }
      });

      // Dynamic Confirm Password Matching Check
      confirmPasswordInput.addEventListener('input', function () {
        if (this.value !== passwordInput.value) {
          document.getElementById('confirmPasswordError').innerText = "Passwords do not match";
          this.classList.add('input-error');
        } else {
          document.getElementById('confirmPasswordError').innerText = "";
          this.classList.remove('input-error');
        }
      });

      // Form Submit Validation
      form.addEventListener('submit', function (e) {
        let isValid = true;
        const username = document.getElementById('username');
        const email = document.getElementById('email');
        const phone = document.getElementById('phone');
        const strongPasswordRegex = /^(?=.*[A-Z])(?=.*[!@#$%^&*])(?=.{8,})/;

        document.querySelectorAll('.error-msg').forEach(el => el.innerText = "");
        document.querySelectorAll('.form-control').forEach(el => el.classList.remove('input-error'));

        if (username.value.trim() === "") {
          document.getElementById('usernameError').innerText = "Name is required";
          username.classList.add('input-error');
          isValid = false;
        }

        if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim())) {
          document.getElementById('emailError').innerText = "Enter a valid email address";
          email.classList.add('input-error');
          isValid = false;
        }

        if (!/^\d{10}$/.test(phone.value.trim())) {
          document.getElementById('phoneError').innerText = "Enter a valid 10-digit phone number";
          phone.classList.add('input-error');
          isValid = false;
        }

        if (!strongPasswordRegex.test(passwordInput.value)) {
          document.getElementById('passwordError').innerText = "Security requirements not met.";
          passwordInput.classList.add('input-error');
          passHint.classList.add('visible');
          isValid = false;
        }

        if (confirmPasswordInput.value.trim() === "") {
          document.getElementById('confirmPasswordError').innerText = "Please confirm your password";
          confirmPasswordInput.classList.add('input-error');
          isValid = false;
        } else if (passwordInput.value !== confirmPasswordInput.value) {
          document.getElementById('confirmPasswordError').innerText = "Passwords do not match";
          confirmPasswordInput.classList.add('input-error');
          isValid = false;
        }

        if (!isValid) e.preventDefault();
      });

      document.querySelectorAll('.form-control').forEach(input => {
        input.addEventListener('input', function() {
          if (this.id !== 'password' && this.id !== 'confirmPassword') {
            this.classList.remove('input-error');
            const errorId = this.id + "Error";
            if(document.getElementById(errorId)) document.getElementById(errorId).innerText = "";
          }
        });
      });
    });
  </script>
</body>

</html>