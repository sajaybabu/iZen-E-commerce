<%- include("../partials/user/userHeader.ejs") %>

<!-- HERO BANNER -->
<section class="my-4">
  <div class="container hero">
    <div class="rounded-4 overflow-hidden shadow-sm position-relative">
        <!-- iOS Product Banner -->
        <img src="https://images.unsplash.com/photo-1510557880182-3d4d3cba35a5?q=80&w=2070&auto=format&fit=crop" 
             class="w-100" 
             alt="Premium iOS Products" 
             style="max-height: 500px; object-fit: cover; filter: brightness(0.8);">
        
        <div class="position-absolute top-50 start-0 translate-middle-y ps-5 text-white">
            <h1 class="display-4 fw-bold">iZen Apple Store</h1>
            <p class="lead">Experience the best of iOS technology.</p>
            <a href="/allProducts" class="btn btn-primary btn-lg rounded-pill px-4">Explore Now</a>
        </div>
    </div>
  </div>
</section>

<!-- NEW ARRIVALS -->
<section id="featured" class="py-5">
  <div class="container">
    <div class="d-flex justify-content-between align-items-center mb-4">
      <h2 class="fw-bold m-0">New Arrivals</h2>
      <a href="/allProducts" class="btn btn-sm btn-outline-dark">View All <i class="bi bi-arrow-right ms-1"></i></a>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-md-3 row-cols-lg-4 row-cols-xl-5 g-4">
      <% newArrivals.forEach(ele => { %>
        <% if(ele.categoryDoc.isListed && ele.productDoc.isListed && ele.isListed && ele.brand?.isListed !== false){ %>
          <div class="col">
            <div class="card h-100 product-card border-0 shadow-sm" onclick='viewProduct("<%= ele._id %>")'>
              <!-- Wishlist Icon Logic -->
              <div class="position-absolute top-0 end-0 m-3 z-3">
                <% let inWishlist = wishlist?.items?.some(item => String(item.variantId) == String(ele._id)); %>
                <i class="bi <%= inWishlist ? 'bi-heart-fill text-danger' : 'bi-heart text-secondary' %> fs-5" 
                   onclick='toggleWishlist(event, "<%= ele._id %>", this, <%= !!inWishlist %>)'></i>
              </div>

              <img src="<%= ele.image[0] %>" class="card-img-top" alt="<%= ele.productDoc.name %>">
              
              <div class="card-body d-flex flex-column text-center">
                <h6 class="card-title text-truncate mb-1"><%= ele.productDoc.name %></h6>
                <p class="text-muted mb-2 small"><%= ele.ram %> | <%= ele.storage %> | <%= ele.color %></p>

                <% 
                  let finalPrice = Math.floor(ele.price - (ele.price * (ele.discount / 100))); 
                %>

                <div class="mt-auto">
                  <div class="d-flex justify-content-center align-items-center gap-2 mb-3">
                    <span class="fw-bold text-dark fs-5">&#8377;<%= finalPrice %></span>
                    <span class="text-decoration-line-through text-muted small">&#8377;<%= ele.price %></span>
                    <span class="badge bg-success-subtle text-success border border-success-subtle badge-discount">
                        <%= ele.discount %>% OFF
                    </span>
                  </div>
                  <button class="btn btn-dark btn-sm w-100 btn-cart" onclick='addToCart(event, "<%= ele._id %>")'>
                    <i class="bi bi-cart-plus me-1"></i> Add to Cart
                  </button>
                </div>
              </div>
            </div>
          </div>
        <% } %>
      <% }) %>
    </div>
  </div>
</section>

<%- include("../partials/user/userFooter.ejs") %>

<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script>
    function viewProduct(id) {
        window.location.href = `/productDetail/${id}`;
    }

    async function addToCart(event, variantId) {
        event.stopPropagation();
        try {
            const request = await fetch('/cart', {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ variantId })
            });

            const res = await request.json();
            if (request.status === 200) {
                Swal.fire({ icon: 'success', title: 'Added to Cart', showConfirmButton: false, timer: 1500 });
            } else {
                Swal.fire({ icon: 'error', title: 'Oops...', text: res.message || 'Error adding to cart' });
            }
        } catch (err) {
            console.error(err);
        }
    }

    async function toggleWishlist(event, variantId, element, isAlreadyIn) {
        event.stopPropagation();
        const url = isAlreadyIn ? '/removefromWishlist' : '/wishlist';
        const method = isAlreadyIn ? 'PATCH' : 'POST';

        try {
            const res = await fetch(url, {
                method: method,
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({ variantId })
            });

            if (res.ok) {
                window.location.reload(); // Simplest way to sync state
            } else if (res.status === 404) {
                Swal.fire('Please Login', 'You need an account to use Wishlist', 'info');
            }
        } catch (err) {
            console.error(err);
        }
    }
</script>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>