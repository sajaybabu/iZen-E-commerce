<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <title>iZen — Otp Verification</title>
  <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

  <style>
    :root {
      --bg: #fbfbfd;
      --card: #ffffff;
      --accent: #e35f00; 
      --muted: #86868b;
      --error: #ff3b30;
      --success: #34c759;
      --border: #d2d2d7;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: var(--bg);
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: 20px;
    }

    .container {
      width: 100%;
      max-width: 420px;
      padding: 48px 32px;
      border-radius: 20px;
      background: var(--card);
      box-shadow: 0 12px 40px rgba(0,0,0,0.06);
      text-align: center;
    }

    .logo { font-weight: 700; font-size: 26px; margin-bottom: 24px; letter-spacing: -0.5px; color: #1d1d1f; }
    .title { font-size: 24px; font-weight: 600; margin: 0 0 12px; color: #1d1d1f; }
    .subtitle { margin: 0 0 32px; color: var(--muted); font-size: 15px; line-height: 1.5; }

    .otp-row { display: flex; gap: 12px; justify-content: center; margin-bottom: 32px; }
    .otp-row input {
      width: 52px;
      height: 60px;
      border-radius: 12px;
      border: 1px solid var(--border);
      background: #f5f5f7;
      font-size: 24px;
      font-weight: 600;
      text-align: center;
      outline: none;
      transition: all 0.2s cubic-bezier(0.4, 0, 0.2, 1);
    }
    .otp-row input:focus { 
      border-color: var(--accent); 
      background: #fff; 
      box-shadow: 0 0 0 4px rgba(0,113,227,0.15); 
    }

    .btn { width: 100%; padding: 16px; border-radius: 14px; border: 0; cursor: pointer; font-size: 16px; font-weight: 600; transition: all 0.2s; }
    .btn.primary { background: var(--accent); color: white; margin-bottom: 12px; }
    .btn.primary:hover { opacity: 0.9; }
    .btn.primary:disabled { background: #e8e8ed; color: #a1a1a6; cursor: not-allowed; }
    
    .btn.ghost { background: transparent; color: var(--accent); font-size: 14px; margin-top: 8px; }
    .btn.ghost:disabled { color: var(--muted); cursor: not-allowed; }

    .message { margin-top: 20px; font-size: 14px; border-radius: 10px; padding: 12px; display: none; line-height: 1.4; }
    .success { background: #f2faf3; color: #1d8035; display: block; border: 1px solid #d4edda; }
    .error { background: #fff2f1; color: #d70015; display: block; border: 1px solid #f8d7da; }

    .timer-text { margin-top: 24px; font-size: 13px; color: var(--muted); letter-spacing: 0.2px; }
    #timer { font-weight: 700; color: #1d1d1f; }
  </style>
</head>
<body>

  <div class="container">
    <div class="logo">iZen</div>
    <h1 class="title">Verify Code</h1>
    <p class="subtitle">For security, we've sent a 4-digit code to your email. Please enter it below to reset your password.</p>

    <div class="otp-row" id="otpFields">
      <input inputmode="numeric" pattern="[0-9]*" maxlength="1" class="otp" autofocus />
      <input inputmode="numeric" pattern="[0-9]*" maxlength="1" class="otp" />
      <input inputmode="numeric" pattern="[0-9]*" maxlength="1" class="otp" />
      <input inputmode="numeric" pattern="[0-9]*" maxlength="1" class="otp" />
    </div>

    <button id="verifyBtn" class="btn primary">Verify & Continue</button>
    <button id="resendBtn" class="btn ghost" disabled>Resend Code</button>

    <div id="message" class="message"></div>
    <p class="timer-text">Wait <span id="timer">60</span>s to resend</p>
  </div>

<script>
    const otpInputs = Array.from(document.querySelectorAll('.otp'));
    const verifyBtn = document.getElementById('verifyBtn');
    const resendBtn = document.getElementById('resendBtn');
    const messageEl = document.getElementById('message');
    const timerEl = document.getElementById('timer');

    let countdown = 60;
    let timerInterval;

    function showFeedback(text, type) {
      messageEl.textContent = text;
      messageEl.className = 'message ' + (type === 'success' ? 'success' : 'error');
      messageEl.style.display = 'block';
    }

    function startTimer() {
      countdown = 60;
      resendBtn.disabled = true;
      clearInterval(timerInterval);
      timerEl.parentElement.style.visibility = 'visible';
      
      timerInterval = setInterval(() => {
        countdown--;
        timerEl.textContent = countdown;
        if (countdown <= 0) {
          clearInterval(timerInterval);
          resendBtn.disabled = false;
          timerEl.parentElement.style.visibility = 'hidden';
        }
      }, 1000);
    }

    // Auto-focus and numeric logic
    otpInputs.forEach((el, idx) => {
      el.addEventListener('input', (e) => {
        const val = e.target.value.replace(/[^0-9]/g, '');
        e.target.value = val.slice(-1);
        if (val && idx < otpInputs.length - 1) otpInputs[idx + 1].focus();
      });

      el.addEventListener('keydown', (e) => {
        if (e.key === 'Backspace' && !e.target.value && idx > 0) {
          otpInputs[idx - 1].focus();
        }
      });
    });

    // Verification Logic (4 Digits)
    verifyBtn.addEventListener('click', function() {
      const otpCode = otpInputs.map(i => i.value).join('');
      
      if (otpCode.length < 4) {
        showFeedback('Please enter all 4 digits.', 'error');
        return;
      }

      verifyBtn.disabled = true;
      verifyBtn.textContent = 'Verifying...';

      $.ajax({
        type: "POST",
        url: "/forgot-password-otp", 
        contentType: "application/json",
        data: JSON.stringify({ otp: otpCode }),
        success: function(response) {
          if (response.success) {
            window.location.href = '/changePassword'; // Redirect to final step
          } else {
            showFeedback(response.message || 'Incorrect code.', 'error');
            verifyBtn.disabled = false;
            verifyBtn.textContent = 'Verify & Continue';
          }
        },
        error: function(xhr) {
          const errMsg = xhr.responseJSON ? xhr.responseJSON.message : 'Something went wrong.';
          showFeedback(errMsg, 'error');
          verifyBtn.disabled = false;
          verifyBtn.textContent = 'Verify & Continue';
        }
      });
    });

    // Resend Logic
    resendBtn.addEventListener('click', function() {
      if (countdown > 0) return;

      $.ajax({
        type: "POST",
        url: "/resend-forgot-otp",
        success: function(response) {
          if (response.success) {
            showFeedback('A fresh code was sent to your email.', 'success');
            startTimer();
            otpInputs.forEach(i => i.value = '');
            otpInputs[0].focus();
          }
        },
        error: function() {
          showFeedback('Error resending code.', 'error');
        }
      });
    });

    startTimer();
</script>
</body>
</html>