<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Login - iZen</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.10.0/font/bootstrap-icons.css" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        html, body {
            font-family: 'Inter', sans-serif;
            background-color: #fff;
            min-height: 100vh;
        }

        /* Navbar & Nav Links */
        .navbar {
            padding: 12px 0;
            border-bottom: 1px solid #eee;
            background-color: #2a2a2a;
        }

        .nav-link {
            color: #fff !important;
            font-size: 0.85rem;
            margin: 0 12px;
        }

        .search-box input {
            border: 1px solid #555;
            border-radius: 5px;
            padding: 6px 30px 6px 10px;
            font-size: 0.8rem;
            width: 170px;
        }

        .nav-icons a {
            color: #fff;
            margin-left: 16px;
            font-size: 1.1rem;
        }

        /* Brand Title Section */
        .brand-title {
            display: flex;
            justify-content: center;
            align-items: center;
            padding: 20px 0;
        }

        .brand-container {
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .brand-title-text {
            font-weight: 600;
            font-size: 2rem;
            color: #333;
        }

        .logo-icon {
            height: 35px;
            width: auto;
        }

        /* Content Wrapper */
        .content-wrapper {
            display: flex;
            align-items: center;
            justify-content: center;
            padding: 20px;
            min-height: 60vh;
        }

        .form-section {
            padding: 30px;
            width: 100%;
            max-width: 380px;
            border: 1px solid #e0e0e0;
            border-radius: 12px;
            background-color: #fff;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
        }

        .form-section h5 {
            color: #1a1a1a;
            font-size: 0.95rem;
            margin-bottom: 20px;
            font-weight: 700; /* Enhanced Boldness */
            padding-bottom: 10px;
            border-bottom: 1px solid #f0f0f0;
        }

        /* Inputs */
        .form-control {
            border: none;
            border-bottom: 1px solid #ccc;
            border-radius: 0;
            padding: 10px 0;
            font-size: 0.85rem;
            background: transparent;
            margin-bottom: 4px;
            transition: border-color 0.3s ease;
        }

        .form-control:focus {
            box-shadow: none;
            border-bottom-color: #1a1a1a;
            background: transparent;
        }

        .input-error {
            border-bottom: 1px solid #d93025 !important;
        }

        /* Password Wrapper & Toggle */
        .password-wrapper {
            position: relative;
            width: 100%;
        }

        .toggle-password {
            position: absolute;
            right: 5px;
            top: 12px;
            cursor: pointer;
            color: #888;
            font-size: 1rem;
            z-index: 10;
        }

        /* Validation & Hints */
        .error-text {
            color: #d93025;
            font-size: 0.7rem;
            min-height: 16px;
            display: block;
            margin-top: 2px;
        }

        .validation-hint {
            font-size: 0.65rem;
            color: #d93025; /* Alert red */
            margin-top: 5px;
            display: block;
            line-height: 1.3;
            opacity: 0; /* Hidden by default */
            transition: opacity 0.3s ease;
            pointer-events: none;
        }

        .validation-hint.visible {
            opacity: 1; /* Fade in when active */
        }

        /* Buttons */
        .form-actions {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin: 25px 0 15px;
        }

        .btn-login {
            background-color: #1a1a1a;
            color: #fff;
            border: none;
            border-radius: 25px;
            padding: 10px 35px;
            font-size: 0.85rem;
            font-weight: 500;
            cursor: pointer;
            transition: background 0.2s;
        }

        .btn-login:hover {
            background-color: #000;
        }

        .forgot-password {
            color: #555;
            text-decoration: none;
            font-size: 0.75rem;
        }

        .btn-google {
            background-color: #fff;
            border: 1px solid #ddd;
            border-radius: 25px;
            padding: 10px 28px;
            font-size: 0.8rem;
            width: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            margin-bottom: 20px;
            text-decoration: none;
            color: #333;
            transition: background 0.2s;
        }

        .btn-google:hover {
            background-color: #f9f9f9;
        }

        .signup-link {
            text-align: center;
            color: #666;
            font-size: 0.75rem;
        }

        .signup-link a {
            color: #1a1a1a;
            text-decoration: none;
            font-weight: 600;
        }

        /* Footer */
        footer {
            background-color: #1a1a1a;
            color: #fff;
            padding: 40px 0 20px;
            margin-top: 40px;
        }

        .footer-bottom {
            border-top: 1px solid #333;
            margin-top: 25px;
            padding-top: 12px;
            text-align: center;
            font-size: 0.75rem;
            color: #aaa;
        }
    </style>
</head>

<body>
    

    <div class="brand-title">
        <div class="brand-container">
            <span class="brand-title-text">iZen</span>
            <img src="/images/blackkkkk.png" alt="Logo" class="logo-icon">
        </div>
    </div>

    <div class="content-wrapper">
        <div class="container-fluid">
            <div class="row align-items-center">
                <div class="col-lg-6 col-md-6 d-none d-md-flex justify-content-center">
                    <img src="/images/login.png" alt="Login illustration" style="max-height: 320px;">
                </div>

                <div class="col-lg-4 col-md-5 col-sm-8 col-11 mx-auto">
                    <div class="form-section">
                        <h5>Enter your details below</h5>
                        
                        <% if (typeof error !== 'undefined') { %>
                            <div class="alert alert-danger py-2 px-3 mb-3" style="font-size: 0.75rem; border-radius: 8px;">
                                <i class="bi bi-exclamation-circle me-2"></i><%= error %>
                            </div>
                        <% } %>

                        <form id="loginForm" action="/login" method="POST" novalidate>
                            <div class="mb-3">
                                <input type="email" id="email" name="email" class="form-control" placeholder="Email">
                                <span id="emailError" class="error-text"></span>
                            </div>

                            <div class="mb-2 password-wrapper">
                                <input type="password" id="password" name="password" class="form-control" placeholder="Password">
                                <i class="bi bi-eye toggle-password" id="togglePassword"></i>
                                <span id="passwordError" class="error-text"></span>
                                <small id="passHint" class="validation-hint">
                                    Must have 8+ characters, one uppercase letter, and one special character.
                                </small>
                            </div>

                            <div class="form-actions">
                                <button type="submit" class="btn-login">Log In</button>
                                <a href="/forgot-password" class="forgot-password">Forgot Password?</a>
                            </div>
                        </form>

                        <a href="/auth/google" class="btn-google">
                            <img src="https://www.google.com/favicon.ico" width="16" alt="Google">
                            Login with Google
                        </a>

                        <p class="signup-link">
                            Don't have account? <a href="/signup">sign up</a>
                        </p>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <footer>
        <div class="container">
            <div class="footer-bottom">
                <p>&copy; Copyright iZen 2026. All rights reserved</p>
            </div>
        </div>
    </footer>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const form = document.getElementById("loginForm");
            const passwordInput = document.getElementById("password");
            const togglePassword = document.getElementById("togglePassword");
            const passHint = document.getElementById("passHint");
            
            // Password Visibility Toggle
            togglePassword.addEventListener("click", function () {
                const isPassword = passwordInput.getAttribute("type") === "password";
                passwordInput.setAttribute("type", isPassword ? "text" : "password");
                this.classList.toggle("bi-eye");
                this.classList.toggle("bi-eye-slash");
            });

            //  Show while typing if criteria aren't met
            passwordInput.addEventListener("input", function() {
                const strongPasswordRegex = /^(?=.*[A-Z])(?=.*[!@#$%^&*])(?=.{8,})/;
                
                if (this.value.length > 0 && !strongPasswordRegex.test(this.value)) {
                    passHint.classList.add("visible");
                } else {
                    passHint.classList.remove("visible");
                }
                
                // Reset error state
                this.classList.remove("input-error");
                document.getElementById("passwordError").textContent = "";
            });

            // Form Submit Validation
            form.addEventListener("submit", function (e) {
                e.preventDefault();
                
                const email = document.getElementById("email");
                const emailError = document.getElementById("emailError");
                const passwordError = document.getElementById("passwordError");
                const strongPasswordRegex = /^(?=.*[A-Z])(?=.*[!@#$%^&*])(?=.{8,})/;
                
                let isValid = true;

                // Email Validation
                if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email.value.trim())) {
                    emailError.textContent = "Please enter a valid email address.";
                    email.classList.add("input-error");
                    isValid = false;
                }

                // Password Validation
                if (!strongPasswordRegex.test(passwordInput.value)) {
                    passwordError.textContent = "Security requirements not met.";
                    passwordInput.classList.add("input-error");
                    passHint.classList.add("visible"); // Force hint on failed submit
                    isValid = false;
                }

                if (isValid) form.submit();
            });

            // Clear email error on type
            document.getElementById("email").addEventListener("input", function() {
                this.classList.remove("input-error");
                document.getElementById("emailError").textContent = "";
            });
        });
    </script>
</body>

</html>