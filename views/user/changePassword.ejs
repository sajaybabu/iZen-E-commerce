<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>iZen — Secure Your Account</title>
  <style>
    :root {
      --bg: #fbfbfd;
      --card: #ffffff;
      --accent: #e35f00; 
      --muted: #86868b;
      --error: #ff3b30;
      --border: #d2d2d7;
    }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
      background-color: var(--bg);
      display: flex;
      align-items: center;
      justify-content: center;
      min-height: 100vh;
      padding: 24px;
    }

    .container {
      width: 100%;
      max-width: 420px;
      padding: 48px 32px;
      border-radius: 20px;
      background: var(--card);
      box-shadow: 0 12px 40px rgba(0,0,0,0.06);
    }

    .header { text-align: center; margin-bottom: 32px; }
    .logo { font-weight: 700; font-size: 26px; margin-bottom: 8px; letter-spacing: -0.5px; color: #1d1d1f; }
    .title { font-size: 24px; font-weight: 600; margin: 0; color: #1d1d1f; }
    .subtitle { margin-top: 10px; color: var(--muted); font-size: 14px; line-height: 1.5; }

    .form-group { margin-bottom: 24px; position: relative; }
    .form-group label { 
      display: block; 
      font-size: 13px; 
      font-weight: 600; 
      margin-bottom: 8px; 
      color: #1d1d1f;
    }
    
    .form-control {
      width: 100%;
      padding: 14px 16px;
      border-radius: 12px;
      border: 1px solid var(--border);
      background: #f5f5f7;
      font-size: 16px;
      outline: none;
      transition: all 0.2s ease;
    }
    .form-control:focus {
      border-color: var(--accent);
      background: #fff;
      box-shadow: 0 0 0 4px rgba(0,113,227,0.15);
    }

    .text-danger {
      font-size: 12px;
      color: var(--error);
      margin-top: 6px;
      display: block;
      line-height: 1.4;
    }

    .btn-custom { 
      width: 100%; 
      padding: 16px; 
      border-radius: 14px; 
      border: 0; 
      cursor: pointer; 
      font-size: 16px; 
      font-weight: 600; 
      background: var(--accent); 
      color: white;
      transition: all 0.2s; 
      margin-top: 8px;
    }
    .btn-custom:hover { opacity: 0.9; transform: translateY(-1px); }
    .btn-custom:active { transform: translateY(0); }
  </style>
</head>
<body>

  <div class="container">
    <div class="header">
      <div class="logo">iZen</div>
      <h1 class="title">Create Password</h1>
      <p class="subtitle">Please enter a new secure password for your account.</p>
    </div>

    <form id="changePasswordForm">
      <div class="form-group">
        <label for="newPassword">New Password</label>
        <input type="password" id="newPassword" class="form-control" placeholder="8-15 characters" />
        <span class="text-danger" id="passMsg"></span>
      </div>

      <div class="form-group">
        <label for="confirmPassword">Confirm New Password</label>
        <input type="password" id="confirmPassword" class="form-control" placeholder="Repeat password" />
        <span class="text-danger" id="confirmPassMsg"></span>
      </div>

      <button id="submit" type="submit" class="btn-custom">Update Password</button>
    </form>
  </div>

  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <script>
    const submitBtn = document.getElementById("submit");
    const passMsg = document.getElementById("passMsg");
    const confirmPassMsg = document.getElementById("confirmPassMsg");
    
    // Strict Regex (Requires 1 letter, 1 number, 1 symbol, 8-15 chars)
    const passwordRegex = /^(?=.*[0-9])(?=.*[!@#$%^&*])(?=.*[A-Za-z])[A-za-z0-9!@#$%^&*]{8,15}$/;

    submitBtn.addEventListener('click', async (event) => {
      event.preventDefault();
      
      const newPassword = document.getElementById("newPassword");
      const confirmPassword = document.getElementById("confirmPassword");

      // Reset messages
      passMsg.textContent = "";
      confirmPassMsg.textContent = "";

      let hasError = false;

      // Validation logic
      if (!passwordRegex.test(newPassword.value)) {
        passMsg.textContent = "Must be 8–15 chars with 1 letter, 1 number, and 1 symbol (!@#$%^&*)";
        hasError = true;
      }

      if (newPassword.value !== confirmPassword.value) {
        confirmPassMsg.textContent = "Passwords do not match.";
        hasError = true;
      }

      if (hasError) return;

      // Proceed with AJAX
      submitBtn.disabled = true;
      submitBtn.textContent = "Updating...";

      try {
        const response = await fetch('/changePassword', {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ 
            // Changed from newPass to password to match your controller
            password: newPassword.value 
          })
        });

        const result = await response.json();

        if (result.success) {
          Swal.fire({
            title: "Success",
            text: "Your password has been securely updated.",
            icon: "success",
            confirmButtonColor: "#0071e3"
          }).then(() => {
            window.location.href = "/login";
          });
        } else {
          throw new Error(result.message || "Failed to update");
        }
      } catch (error) {
        Swal.fire({
          title: "Error",
          text: error.message || "Failed to change password. Please try again.",
          icon: "error",
          confirmButtonColor: "#0071e3"
        });
        submitBtn.disabled = false;
        submitBtn.textContent = "Update Password";
      }
    });
  </script>
</body>
</html>