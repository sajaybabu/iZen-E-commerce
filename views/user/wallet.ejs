<%- include("../partials/user/shopHeader.ejs") %>
<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-10">
            
            <!-- Page Title -->
            <div class="d-flex align-items-center justify-content-between mb-4">
                <h2 class="fw-bold m-0">My iZen Wallet</h2>
                <a href="/profile" class="btn btn-outline-dark btn-sm rounded-pill px-3">
                    <i class="bi bi-arrow-left me-1"></i> Back to Profile
                </a>
            </div>

            <!-- Balance Card -->
            <div class="card border-0 shadow-sm rounded-4 bg-dark text-white p-4 mb-4">
                <div class="card-body d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div>
                        <span class="text-uppercase text-white-50 small fw-bold tracking-wider">Available Balance</span>
                        <h1 class="display-5 fw-bold mb-0 mt-1">₹<%= wallet ? wallet.balance.toLocaleString('en-IN') : 0 %></h1>
                    </div>
                    <div>
                        <span class="badge bg-success-subtle text-success border border-success-subtle px-3 py-2 rounded-pill">
                            <i class="bi bi-shield-check me-1"></i> Active Account
                        </span>
                    </div>
                </div>
            </div>

            <!-- Refer & Earn Card -->
            <div class="card border-0 shadow-sm rounded-4 p-4 mb-4">
                <div class="d-flex align-items-center justify-content-between flex-wrap gap-3">
                    <div>
                        <h5 class="fw-bold mb-1">Refer & Earn</h5>
                        <p class="text-muted small mb-0">Share your referral code with friends and get credited when they sign up.</p>
                    </div>
                    <div class="d-flex align-items-center gap-2">
                        <div class="bg-light border border-2 rounded-3 px-3 py-2 text-center">
                            <span class="small text-muted d-block" style="font-size: 0.7rem;">YOUR CODE</span>
                            <span class="fw-bold text-dark font-monospace text-uppercase" id="referralCodeText" style="letter-spacing: 1px;">
                                <%= wallet && wallet.referralCode ? wallet.referralCode : 'N/A' %>
                            </span>
                        </div>
                        <button class="btn btn-dark rounded-3 py-2 px-3" id="copyCodeBtn" onclick="copyReferralCode()">
                            <i class="bi bi-clipboard me-1"></i> Copy Code
                        </button>
                    </div>
                </div>
            </div>

            <!-- Transaction History -->
            <div class="card border-0 shadow-sm rounded-4">
                <div class="card-header bg-transparent border-0 pt-4 px-4 pb-2">
                    <h5 class="fw-bold m-0">Transaction History</h5>
                </div>
                <div class="card-body p-0">
                    <% if (wallet && wallet.transactions && wallet.transactions.length > 0) { %>
                        <div class="table-responsive">
                            <table class="table table-hover align-middle mb-0">
                                <thead class="table-light">
                                    <tr>
                                        <th class="ps-4">Transaction ID</th>
                                        <th>Date</th>
                                        <th>Purpose / Description</th>
                                        <th>Type</th>
                                        <th class="text-end pe-4">Amount</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% wallet.transactions.forEach(tx => { %>
                                        <tr>
                                            <td class="ps-4 fw-medium text-secondary">
                                                <small><%= tx.transactionId %></small>
                                            </td>
                                            <td>
                                                <small class="text-muted">
                                                    <%= new Date(tx.createdAt).toLocaleDateString('en-IN', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                                                </small>
                                            </td>
                                            <td>
                                                <div class="fw-bold text-dark"><%= tx.purpose %></div>
                                                <small class="text-muted"><%= tx.description || 'N/A' %></small>
                                            </td>
                                            <td>
                                                <% if (tx.type === 'credit') { %>
                                                    <span class="badge bg-success-subtle text-success px-2 py-1 rounded-pill">Credit</span>
                                                <% } else { %>
                                                    <span class="badge bg-danger-subtle text-danger px-2 py-1 rounded-pill">Debit</span>
                                                <% } %>
                                            </td>
                                            <td class="text-end pe-4 fw-bold <%= tx.type === 'credit' ? 'text-success' : 'text-dark' %>">
                                                <%= tx.type === 'credit' ? '+' : '-' %> ₹<%= tx.amount.toLocaleString('en-IN') %>
                                            </td>
                                        </tr>
                                    <% }) %>
                                </tbody>
                            </table>
                        </div>
                    <% } else { %>
                        <div class="text-center py-5">
                            <i class="bi bi-wallet2 text-muted display-4"></i>
                            <p class="text-muted mt-2 mb-0">No transactions recorded yet.</p>
                        </div>
                    <% } %>
                </div>
            </div>

        </div>
    </div>
</div>

<script>
  function copyReferralCode() {
    const codeText = document.getElementById("referralCodeText").innerText.trim();
    if (codeText && codeText !== 'N/A') {
      navigator.clipboard.writeText(codeText);
      const btn = document.getElementById("copyCodeBtn");
      btn.innerHTML = '<i class="bi bi-check2"></i> Copied!';
      setTimeout(() => {
        btn.innerHTML = '<i class="bi bi-clipboard me-1"></i> Copy Code';
      }, 2000);
    }
  }
</script>
<%- include('../partials/User/userFooter') %>